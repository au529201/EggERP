
@using Microsoft.AspNetCore.Components

@if (TotalCount > 0)
{
    <div class="d-flex flex-wrap justify-content-between
                align-items-center gap-2 mt-3">

        <span class="small text-muted">
            Showing @StartRecord–@EndRecord of @TotalCount records
        </span>

        @if (TotalPages > 1)
        {
            <nav aria-label="Table pagination">
                <div class="d-flex flex-wrap align-items-center gap-1">
                    <button type="button"
                            class="btn btn-outline-secondary btn-sm"
                            disabled="@(Disabled || Page <= 1)"
                            @onclick="() => ChangePage(Page - 1)">
                        Prev
                    </button>

                    @foreach (var number in VisiblePages)
                    {
                        var target = number;

                        <button type="button"
                                class="btn btn-sm @(Page == target
                                    ? "btn-primary"
                                    : "btn-outline-secondary")"
                                aria-label="Go to page @target"
                                aria-current="@(Page == target ? "page" : null)"
                                disabled="@Disabled"
                                @onclick="() => ChangePage(target)">
                            @target
                        </button>
                    }

                    <button type="button"
                            class="btn btn-outline-secondary btn-sm"
                            disabled="@(Disabled || Page >= TotalPages)"
                            @onclick="() => ChangePage(Page + 1)">
                        Next
                    </button>
                </div>
            </nav>
        }
    </div>
}

@code {
    [Parameter] public int TotalCount { get; set; }
    [Parameter] public int Page { get; set; } = 1;
    [Parameter] public int PageSize { get; set; } = 10;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<int> PageChanged { get; set; }

    private int SafePageSize => Math.Max(1, PageSize);
    private int SafeTotal => Math.Max(0, TotalCount);

    private int TotalPages => Math.Max(1,
        (int)Math.Ceiling(SafeTotal / (double)SafePageSize));

    private int CurrentPage => Math.Clamp(Page, 1, TotalPages);

    private int StartRecord =>
        (CurrentPage - 1) * SafePageSize + 1;

    private int EndRecord =>
        Math.Min(CurrentPage * SafePageSize, SafeTotal);

    private IEnumerable<int> VisiblePages
    {
        get
        {
            const int maxVisible = 5;

            var start = Math.Max(1, CurrentPage - 2);
            var end = Math.Min(TotalPages, start + maxVisible - 1);

            start = Math.Max(1, end - maxVisible + 1);

            return Enumerable.Range(start, end - start + 1);
        }
    }

    private async Task ChangePage(int target)
    {
        if (Disabled || target < 1 ||
            target > TotalPages || target == CurrentPage)
            return;

        await PageChanged.InvokeAsync(target);
    }
}
