@page "/customers/edit/{Id:guid}"
@attribute [Authorize(Roles = "Admin,Manager")]
@using EggERP.Shared.Models
@using EggERP.Shared.Services
@inject ICustomerApiService CustomerApiService
@inject NavigationManager Navigation

<h3>Edit Customer</h3>

@if (isLoading)
{
    <p>Loading...</p>
}
else if (notFound)
{
    <p>Customer not found.</p>
}
else
{
    <EditForm Model="@editModel" OnValidSubmit="HandleSave">
        <div class="mb-3">
            <label>Name</label>
            <InputText class="form-control" @bind-Value="editModel.Name" />
        </div>
        <div class="mb-3">
            <label>Email</label>
            <InputText class="form-control" @bind-Value="editModel.Email" />
        </div>
        <div class="mb-3">
            <label>Phone</label>
            <InputText class="form-control" @bind-Value="editModel.Phone" />
        </div>
        <div class="mb-3">
            <label>Address</label>
            <InputText class="form-control" @bind-Value="editModel.Address" />
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <p style="color:red">@errorMessage</p>
        }

<button type="submit"
        class="btn btn-primary"
        disabled="@isSaving">
    @(isSaving ? "Saving..." : "Save")
</button>    </EditForm>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private CustomerFormModel editModel = new();
private bool isLoading = true;
private bool notFound = false;
private bool isSaving = false;
private string? errorMessage;
    private readonly Guid businessId = Guid.Parse("11111111-1111-1111-1111-111111111111");

    protected override async Task OnInitializedAsync()
    {
        var customer = await CustomerApiService.GetCustomerByIdAsync(businessId, Id);

        if (customer is null)
        {
            notFound = true;
            isLoading = false;
            return;
        }

        editModel = new CustomerFormModel
        {
            Name = customer.Name,
            Email = customer.Email ?? string.Empty,
            Phone = customer.Phone ?? string.Empty,
            Address = customer.Address ?? string.Empty
        };

        isLoading = false;
    }

private async Task HandleSave()
{
    if (isSaving)
    {
        return;
    }

    errorMessage = null;

    if (string.IsNullOrWhiteSpace(editModel.Name))
    {
        errorMessage = "Customer name is required.";
        return;
    }

    isSaving = true;

    var request = new UpdateCustomerRequest
    {
        Id = Id,
        BusinessId = businessId,
        Name = editModel.Name.Trim(),
        Email = string.IsNullOrWhiteSpace(editModel.Email)
            ? null
            : editModel.Email.Trim(),
        Phone = string.IsNullOrWhiteSpace(editModel.Phone)
            ? null
            : editModel.Phone.Trim(),
        Address = string.IsNullOrWhiteSpace(editModel.Address)
            ? null
            : editModel.Address.Trim(),
        IsActive = true
    };

    try
    {
        await CustomerApiService.UpdateCustomerAsync(request);
        Navigation.NavigateTo("/customers");
    }
    catch (Exception ex)
    {
        errorMessage = $"Failed to save customer: {ex.Message}";
        isSaving = false;
    }
}
    private class CustomerFormModel
    {
        public string Name { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Phone { get; set; } = string.Empty;
        public string Address { get; set; } = string.Empty;
    }
}