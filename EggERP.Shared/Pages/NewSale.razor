@page "/sales/new"
@using EggERP.Shared.Models
@using EggERP.Shared.Services
@inject ISaleApiService SaleApiService
@inject IProductApiService ProductApiService
@inject ICustomerApiService CustomerApiService
@inject NavigationManager Navigation
@inject IJSRuntime JsRuntime

<h3>New Sale</h3>

@if (fromFlockOrEggRedirect)
{
    <div class="alert alert-info">
        Completing this sale will record the removal for the flock/egg stock you selected.
    </div>
}

@if (isLoading)
{
    <p>Loading...</p>
}
else
{
    <div class="mb-3" style="max-width: 420px;">
        <label>Customer</label>
        <select class="form-select"
                @bind="selectedCustomerId"
                disabled="@isSaving">
            <option value="">Walk-in (no customer)</option>

            @foreach (var customer in customers)
            {
                <option value="@customer.Id">
                    @customer.Name
                </option>
            }
        </select>
    </div>

    <div class="table-responsive">
        <table class="table txn-table">
            <thead>
                <tr>
                    <th class="txn-col-product">Type / Product</th>
                    <th>Description</th>
                    <th class="txn-col-qty">Qty</th>
                    <th class="txn-col-money">Price</th>
                    <th class="txn-col-total">Sale</th>
                    <th class="txn-col-action"></th>
                </tr>
            </thead>

            <tbody>
                @foreach (var line in lines)
                {
                    <tr>
                        <td class="txn-col-product">
                            <select class="form-select"
                                    @bind="line.ProductId"
                                    @bind:after="() => OnProductChanged(line)"
                                    disabled="@isSaving">
                                <option value="">Select product</option>

                                @foreach (var product in products)
                                {
                                    <option value="@product.Id">
                                        @product.Type - @product.Description
                                    </option>
                                }
                            </select>
                        </td>

                        <td>
                            @GetDescription(line.ProductId)
                        </td>

                        <td class="txn-col-qty">
                            <input type="number"
                                   step="1"
                                   min="1"
                                   max="9999"
                                   class="form-control"
                                   @bind="line.Quantity"
                                   disabled="@isSaving" />
                        </td>

                        <td class="txn-col-money">
                            <input type="number"
                                   step="0.01"
                                   min="0"
                                   class="form-control"
                                   @bind="line.UnitPrice"
                                   disabled="@isSaving" />
                        </td>

                        <td class="txn-col-total">
                            @((line.Quantity * line.UnitPrice).ToString("N2"))
                        </td>

                        <td class="txn-col-action">
                            <button type="button"
                                    class="btn btn-sm btn-danger"
                                    @onclick="() => RemoveLine(line)"
                                    disabled="@isSaving">
                                Remove
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <button type="button"
            class="btn btn-secondary"
            @onclick="AddLine"
            disabled="@isSaving">
        + Add Line
    </button>

    <h5 class="txn-total">
        Total Amount: @TotalAmount.ToString("N2")
    </h5>

    <div class="txn-row">
        <div class="txn-field">
            <label>Status</label>
            <select class="form-select"
                    @bind="status"
                    disabled="@isSaving">
                <option value="Paid">Paid</option>
                <option value="Pending">Pending</option>
            </select>
        </div>

        <div class="txn-field">
            <label>Payment Method</label>
            <select class="form-select"
                    @bind="paymentMethod"
                    @bind:after="OnPaymentMethodChanged"
                    disabled="@isSaving">
                <option value="Cash">Cash</option>
                <option value="Credit Card">Credit Card</option>
                <option value="Debit Card">Debit Card</option>
                <option value="Other">Other</option>
            </select>
        </div>

        <div class="txn-field">
            <label>Bank Name / Payment Source</label>
            <input class="form-control"
                   @bind="bankName"
                   placeholder="e.g. BDO, GCash, Maya"
                   disabled="@(isSaving || paymentMethod == "Cash")" />
        </div>

        <div class="txn-field">
            <label>Reference ID</label>
            <input class="form-control"
                   @bind="referenceNumber"
                   placeholder="Required for non-cash"
                   disabled="@(isSaving || paymentMethod == "Cash")" />
        </div>

        <div class="txn-field">
            <label>Date</label>
            <input type="date"
                   class="form-control"
                   @bind="transactionDate"
                   disabled="@isSaving" />
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">
            @errorMessage
        </div>
    }

    <div class="txn-bottom-row">
        <div class="txn-notes">
            <label>Notes</label>
            <textarea class="form-control"
                      @bind="notes"
                      placeholder="Optional transaction notes..."
                      disabled="@isSaving"></textarea>
        </div>

        <div class="txn-actions">
            <button type="button"
                    class="btn btn-outline-secondary"
                    @onclick="Cancel"
                    disabled="@isSaving">
                Cancel
            </button>

            <button type="button"
                    class="btn btn-primary"
                    @onclick="HandleSave"
                    disabled="@isSaving">
                @(isSaving ? "Processing..." : "Complete Transaction")
            </button>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "productId")]
    private string? QueryProductId { get; set; }

    [SupplyParameterFromQuery(Name = "qty")]
    private decimal? QueryQty { get; set; }

    private class SaleLine
    {
        public string ProductId { get; set; } = string.Empty;
        public decimal Quantity { get; set; } = 1;
        public decimal UnitPrice { get; set; }
    }

    private List<ProductDto> products = new();
    private List<CustomerDto> customers = new();
    private List<SaleLine> lines = new();

    private string selectedCustomerId = string.Empty;

    private string paymentMethod = "Cash";
    private string status = "Paid";

    private string? bankName;
    private string? referenceNumber;
    private string? notes;

    private DateTime transactionDate = DateTime.Today;

    private bool isLoading = true;
    private bool isSaving;
    private bool fromFlockOrEggRedirect;

    private string? errorMessage;

    private readonly Guid businessId =
        Guid.Parse("11111111-1111-1111-1111-111111111111");

    private decimal TotalAmount =>
        lines.Sum(l => l.Quantity * l.UnitPrice);

    protected override async Task OnInitializedAsync()
    {
        products =
            await ProductApiService.GetProductsAsync();

        customers =
            await CustomerApiService.GetCustomersAsync(
                businessId);

        if (!string.IsNullOrWhiteSpace(QueryProductId) &&
            Guid.TryParse(QueryProductId, out var productId) &&
            products.Any(p => p.Id == productId))
        {
            var line = new SaleLine
            {
                ProductId = QueryProductId,
                Quantity =
                    QueryQty is > 0
                        ? QueryQty.Value
                        : 1
            };

            OnProductChanged(line);

            lines.Add(line);

            fromFlockOrEggRedirect = true;
        }
        else
        {
            lines.Add(new SaleLine());
        }

        isLoading = false;
    }

    private string GetDescription(
        string productId)
    {
        if (!Guid.TryParse(
                productId,
                out var id))
        {
            return string.Empty;
        }

        return products
            .FirstOrDefault(p => p.Id == id)
            ?.Description
            ?? string.Empty;
    }

    private void OnProductChanged(
        SaleLine line)
    {
        if (!Guid.TryParse(
                line.ProductId,
                out var productId))
        {
            return;
        }

        var product =
            products.FirstOrDefault(
                p => p.Id == productId);

        if (product is not null)
        {
            line.UnitPrice =
                product.SellingPrice;
        }
    }

    private void AddLine()
    {
        if (isSaving)
        {
            return;
        }

        lines.Add(new SaleLine());
    }

    private void RemoveLine(
        SaleLine line)
    {
        if (isSaving)
        {
            return;
        }

        lines.Remove(line);

        if (lines.Count == 0)
        {
            lines.Add(new SaleLine());
        }
    }

    private void OnPaymentMethodChanged()
    {
        if (paymentMethod == "Cash")
        {
            bankName = null;
            referenceNumber = null;
        }
    }

    private async Task Cancel()
    {
        if (isSaving)
        {
            return;
        }

        var confirmed =
            await JsRuntime.InvokeAsync<bool>(
                "confirm",
                "Discard this sale and go back? Unsaved changes will be lost.");

        if (confirmed)
        {
            Navigation.NavigateTo("/sales");
        }
    }

    private async Task HandleSave()
    {
        if (isSaving)
        {
            return;
        }

        errorMessage = null;

        var enteredLines =
            lines.Where(l =>
                    !string.IsNullOrWhiteSpace(
                        l.ProductId))
                .ToList();

        if (enteredLines.Count == 0)
        {
            errorMessage =
                "Add at least one valid sale line.";
            return;
        }

        if (enteredLines.Any(l =>
                l.Quantity <= 0))
        {
            errorMessage =
                "Quantity must be greater than zero.";
            return;
        }

        if (enteredLines.Any(l =>
                l.Quantity > 9999))
        {
            errorMessage =
                "Quantity cannot exceed 9,999 per line.";
            return;
        }

        if (enteredLines.Any(l =>
                l.UnitPrice < 0))
        {
            errorMessage =
                "Unit price cannot be negative.";
            return;
        }

        if (status != "Paid" &&
            status != "Pending")
        {
            errorMessage =
                "Status must be Paid or Pending.";
            return;
        }

        if (paymentMethod != "Cash" &&
            (string.IsNullOrWhiteSpace(bankName) ||
             string.IsNullOrWhiteSpace(referenceNumber)))
        {
            errorMessage =
                "Bank Name / Payment Source and Reference ID are required for non-cash payments.";
            return;
        }

        Guid? customerId =
            Guid.TryParse(
                selectedCustomerId,
                out var parsedCustomerId)
                ? parsedCustomerId
                : null;

        var request =
            new CreateSaleRequest
            {
                BusinessId =
                    businessId,

                CustomerId =
                    customerId,

                Items =
                    enteredLines.Select(l =>
                        new CreateSaleItemInput
                        {
                            ProductId =
                                Guid.Parse(l.ProductId),

                            Quantity =
                                l.Quantity,

                            UnitPrice =
                                l.UnitPrice
                        }).ToList(),

                PaymentMethod =
                    paymentMethod,

                PaymentSource =
                    paymentMethod == "Cash"
                        ? null
                        : bankName?.Trim(),

                ReferenceNumber =
                    paymentMethod == "Cash"
                        ? null
                        : referenceNumber?.Trim(),

                Status =
                    status,

                SaleDate =
                    transactionDate,

                Notes =
                    string.IsNullOrWhiteSpace(notes)
                        ? null
                        : notes.Trim()
            };

        isSaving = true;

        try
        {
            await SaleApiService
                .CreateSaleAsync(request);

            Navigation.NavigateTo("/sales");
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Failed to save sale: {ex.Message}";

            isSaving = false;
        }
    }
}