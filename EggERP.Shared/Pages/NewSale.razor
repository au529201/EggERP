@page "/sales/new"
@using EggERP.Shared.Models
@using EggERP.Shared.Services
@inject ISaleApiService SaleApiService
@inject IProductApiService ProductApiService
@inject ICustomerApiService CustomerApiService
@inject NavigationManager Navigation

<h3>New Sale</h3>

@if (fromFlockOrEggRedirect)
{
    <div class="alert alert-info">
        Completing this sale will record the removal for the flock/egg stock you just selected.
    </div>
}

@if (isLoading)
{
    <p>Loading...</p>
}
else
{
    <div class="mb-3" style="max-width:400px;">
        <label>Customer</label>
        <select class="form-select" @bind="selectedCustomerId">
            <option value="">Walk-in (no customer)</option>
            @foreach (var customer in customers)
            {
                <option value="@customer.Id">@customer.Name</option>
            }
        </select>
    </div>

    <table class="table">
        <thead>
            <tr>
                <th>Type</th>
                <th>Description</th>
                <th>Quantity</th>
                <th>Price</th>
                <th>Sale</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var line in lines)
            {
                <tr>
                    <td>
                        <select class="form-select" @bind="line.ProductId" @bind:after="() => OnProductChanged(line)">
                            <option value="">Select product</option>
                            @foreach (var product in products)
                            {
                                <option value="@product.Id">@product.Type - @product.Description</option>
                            }
                        </select>
                    </td>
                    <td>@GetDescription(line.ProductId)</td>
                    <td>
                        <input type="number" step="1" min="1" class="form-control" @bind="line.Quantity" />
                    </td>
                    <td>
                        <input type="number" step="0.01" class="form-control" @bind="line.UnitPrice" />
                    </td>
                    <td>@((line.Quantity * line.UnitPrice).ToString("N2"))</td>
                    <td>
                        <button class="btn btn-sm btn-danger" @onclick="() => RemoveLine(line)">Remove</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <button class="btn btn-secondary mb-3" @onclick="AddLine">+ Add Line</button>

    <h5>Total: @(lines.Sum(l => l.Quantity * l.UnitPrice).ToString("N2"))</h5>

    <div class="row mb-3" style="max-width:700px;">
        <div class="col-md-4">
            <label>Status</label>
            <select class="form-select" @bind="status">
                <option value="Paid">Paid</option>
                <option value="Pending">Pending</option>
            </select>
        </div>
        <div class="col-md-4">
            <label>Mode of Payment</label>
            <select class="form-select" @bind="paymentMethod">
                <option value="Cash">Cash</option>
                <option value="GCash">GCash</option>
                <option value="Maya">Maya</option>
                <option value="Bank Transfer">Bank Transfer</option>
                <option value="Other">Other</option>
            </select>
        </div>
    </div>

    @if (paymentMethod != "Cash")
    {
        <div class="row mb-3" style="max-width:400px;">
            <div class="col-md-6">
                <label>Reference ID</label>
                <input class="form-control" @bind="referenceNumber" placeholder="Required for non-cash" />
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <p style="color:red">@errorMessage</p>
    }

<button class="btn btn-primary" @onclick="HandleSave">Complete Transaction</button>}

@code {
    [SupplyParameterFromQuery(Name = "productId")]
    private string? QueryProductId { get; set; }

    [SupplyParameterFromQuery(Name = "qty")]
    private decimal? QueryQty { get; set; }

    private class SaleLine
    {
        public string ProductId { get; set; } = string.Empty;
        public decimal Quantity { get; set; } = 1;
        public decimal UnitPrice { get; set; }
    }

    private List<ProductDto> products = new();
    private List<CustomerDto> customers = new();
    private List<SaleLine> lines = new();
    private string selectedCustomerId = string.Empty;
    private string paymentMethod = "Cash";
    private string status = "Paid";
    private string? referenceNumber;
    private bool isLoading = true;
    private bool fromFlockOrEggRedirect = false;
    private string? errorMessage;

    private readonly Guid businessId = Guid.Parse("11111111-1111-1111-1111-111111111111");

    protected override async Task OnInitializedAsync()
    {
        products = await ProductApiService.GetProductsAsync(businessId);
        customers = await CustomerApiService.GetCustomersAsync(businessId);

        if (!string.IsNullOrEmpty(QueryProductId) && Guid.TryParse(QueryProductId, out var pid)
            && products.Any(p => p.Id == pid))
        {
            var prefillLine = new SaleLine
            {
                ProductId = QueryProductId,
                Quantity = QueryQty is > 0 ? QueryQty.Value : 1
            };
            OnProductChanged(prefillLine);
            lines.Add(prefillLine);
            fromFlockOrEggRedirect = true;
        }
        else
        {
            lines.Add(new SaleLine());
        }

        isLoading = false;
    }

    private string GetDescription(string productId)
    {
        if (Guid.TryParse(productId, out var id))
        {
            return products.FirstOrDefault(p => p.Id == id)?.Description ?? string.Empty;
        }
        return string.Empty;
    }

    private void OnProductChanged(SaleLine line)
    {
        if (Guid.TryParse(line.ProductId, out var productId))
        {
            var product = products.FirstOrDefault(p => p.Id == productId);
            if (product is not null)
            {
                line.UnitPrice = product.SellingPrice;
            }
        }
    }

    private void AddLine()
    {
        lines.Add(new SaleLine());
    }

    private void RemoveLine(SaleLine line)
    {
        lines.Remove(line);
    }

    private async Task HandleSave()
    {
        errorMessage = null;

        var validLines = lines.Where(l => !string.IsNullOrEmpty(l.ProductId) && l.Quantity > 0).ToList();

        if (validLines.Count == 0)
        {
            errorMessage = "Add at least one valid line item.";
            return;
        }

        if (paymentMethod != "Cash" && string.IsNullOrWhiteSpace(referenceNumber))
        {
            errorMessage = "Reference ID is required for non-cash payments.";
            return;
        }

        Guid? customerId = Guid.TryParse(selectedCustomerId, out var cid) ? cid : null;

        var request = new CreateSaleRequest
        {
            BusinessId = businessId,
            CustomerId = customerId,
            Items = validLines.Select(l => new CreateSaleItemInput
            {
                ProductId = Guid.Parse(l.ProductId),
                Quantity = l.Quantity,
                UnitPrice = l.UnitPrice
            }).ToList(),
            PaymentMethod = paymentMethod,
            PaymentSource = paymentMethod == "Cash" ? null : paymentMethod,
            ReferenceNumber = paymentMethod == "Cash" ? null : referenceNumber,
            Status = status
        };

        try
        {
            await SaleApiService.CreateSaleAsync(request);
            Navigation.NavigateTo("/sales");
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to save sale: {ex.Message}";
        }
    }
}