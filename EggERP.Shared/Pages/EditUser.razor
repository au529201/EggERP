@page "/settings/users/edit/{Id:guid}"
@attribute [Authorize(Roles = "Admin")]
@using EggERP.Shared.Models
@using EggERP.Shared.Services
@inject IUserManagementApiService UserManagementApiService
@inject NavigationManager Navigation

<h3>Edit User</h3>

@if (isLoading)
{
    <p>Loading...</p>
}
else if (notFound)
{
    <p>User not found.</p>
}
else
{
    <EditForm Model="@editModel" OnValidSubmit="HandleSave">
        <div class="mb-3">
            <label>Full Name</label>
            <InputText class="form-control" @bind-Value="editModel.FullName" />
        </div>
        <div class="mb-3">
            <label>Role</label>
            <select class="form-select" @bind="editModel.Role">
                <option value="Manager">Manager</option>
                <option value="Staff">Staff</option>
            </select>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <p style="color:red">@errorMessage</p>
        }

        <button type="submit" class="btn btn-primary">Save</button>
    </EditForm>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private readonly Guid businessId = Guid.Parse("11111111-1111-1111-1111-111111111111");
    private UpdateUserRequest editModel = new();
    private bool isLoading = true;
    private bool notFound = false;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        var users = await UserManagementApiService.GetUsersAsync(businessId);
        var user = users.FirstOrDefault(u => u.Id == Id);

        if (user is null)
        {
            notFound = true;
            isLoading = false;
            return;
        }

        editModel = new UpdateUserRequest
        {
            Id = user.Id,
            BusinessId = businessId,
            FullName = user.FullName,
            Role = user.Role
        };

        isLoading = false;
    }

    private async Task HandleSave()
    {
        errorMessage = null;

        var error = await UserManagementApiService.UpdateUserAsync(editModel);
        if (error is not null)
        {
            errorMessage = error;
            return;
        }

        Navigation.NavigateTo("/settings/users");
    }
}