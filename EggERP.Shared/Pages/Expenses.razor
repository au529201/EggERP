@page "/expenses"
@attribute [Authorize(Roles = "Admin,Manager")]
@using EggERP.Shared.Models
@using EggERP.Shared.Services
@inject IExpenseApiService ExpenseApiService

<h3>Expenses</h3>
<a class="btn btn-primary mb-3" href="/expenses/add">+ Add Expense</a>

@if (expenses is null)
{
    <p>Loading...</p>
}
else if (expenses.Count == 0)
{
    <p>No expenses found.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Date</th>
                <th>Description</th>
                <th>Category</th>
                <th>Amount</th>
                <th>Payment Method</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var expense in PagedExpenses)
            {
                <tr>
                    <td>@expense.ExpenseDateUtc.ToLocalTime().ToString("d")</td>
                    <td>@expense.Description</td>
                    <td>@expense.Category</td>
                    <td>@expense.Amount.ToString("N2")</td>
                    <td>@expense.PaymentMethod</td>
                    <td>@expense.Status</td>
                </tr>
            }
        </tbody>
    </table>

    <Pager Total="expenses.Count" Page="page" PageSize="pageSize" PageChanged="OnPageChanged" />
}

@code {
    private List<ExpenseDto>? expenses;
    private readonly Guid businessId = Guid.Parse("11111111-1111-1111-1111-111111111111");

    private int page = 1;
    private const int pageSize = 7;

    private IEnumerable<ExpenseDto> PagedExpenses =>
        (expenses ?? new List<ExpenseDto>()).Skip((page - 1) * pageSize).Take(pageSize);

    private void OnPageChanged(int newPage) => page = newPage;

    protected override async Task OnInitializedAsync()
    {
        expenses = await ExpenseApiService.GetExpensesAsync(businessId);
    }
}