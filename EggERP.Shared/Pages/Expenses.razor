@page "/expenses"
@attribute [Authorize(Roles = "Admin,Manager")]
@using EggERP.Shared.Models
@using EggERP.Shared.Services
@inject IExpenseApiService ExpenseApiService

<h3>Expenses</h3>

<a class="btn btn-primary mb-3" href="/expenses/add">
    + Add Expense
</a>

<div class="row mb-3 g-2">
    <div class="col-md-5">
        <label>Search</label>
        <input class="form-control"
               placeholder="Description, category or payment method..."
               @bind="searchText"
               @bind:event="oninput"
               @bind:after="ResetPage" />
    </div>

    <div class="col-md-3">
        <label>Status</label>
        <select class="form-select"
                @bind="selectedStatus"
                @bind:after="ResetPage">
            <option value="">All</option>
            <option value="Paid">Paid</option>
            <option value="Pending">Pending</option>
        </select>
    </div>

    <div class="col-md-2">
        <label>From</label>
        <input type="date"
               class="form-control"
               @bind="startDate"
               @bind:after="ResetPage" />
    </div>

    <div class="col-md-2 d-flex align-items-end">
        <button class="btn btn-outline-secondary w-100"
                @onclick="ClearFilters">
            Clear
        </button>
    </div>
</div>

@if (expenses is null)
{
    <p>Loading...</p>
}
else if (!FilteredExpenses.Any())
{
    <p>No matching expenses found.</p>
}
else
{
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Description</th>
                    <th>Category</th>
                    <th>Amount</th>
                    <th>Payment Method</th>
                    <th>Status</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var expense in PagedExpenses)
                {
                    <tr>
                        <td>@expense.ExpenseDateUtc.ToLocalTime().ToString("d")</td>
                        <td>@expense.Description</td>
                        <td>@expense.Category</td>
                        <td>@expense.Amount.ToString("N2")</td>
                        <td>@expense.PaymentMethod</td>
                        <td>
                            @if (expense.Status == "Paid")
                            {
                                <span class="badge bg-success">Paid</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">
                                    @expense.Status
                                </span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <Pager Total="FilteredExpenses.Count()"
           Page="page"
           PageSize="pageSize"
           PageChanged="OnPageChanged" />
}

@code {
    private List<ExpenseDto>? expenses;

    private string searchText = string.Empty;
    private string selectedStatus = string.Empty;
    private DateTime? startDate;

    private readonly Guid businessId =
        Guid.Parse("11111111-1111-1111-1111-111111111111");

    private int page = 1;
    private const int pageSize = 7;

    private IEnumerable<ExpenseDto> FilteredExpenses =>
        (expenses ?? new List<ExpenseDto>())
        .Where(e =>
            (
                string.IsNullOrWhiteSpace(searchText) ||
                (e.Description ?? string.Empty).Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                (e.Category ?? string.Empty).Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                (e.PaymentMethod ?? string.Empty).Contains(searchText, StringComparison.OrdinalIgnoreCase)
            )
            &&
            (
                string.IsNullOrWhiteSpace(selectedStatus) ||
                e.Status == selectedStatus
            )
            &&
            (
                !startDate.HasValue ||
                e.ExpenseDateUtc.ToLocalTime().Date >= startDate.Value.Date
            ));

    private IEnumerable<ExpenseDto> PagedExpenses =>
        FilteredExpenses
            .Skip((page - 1) * pageSize)
            .Take(pageSize);

    protected override async Task OnInitializedAsync()
    {
        expenses = await ExpenseApiService.GetExpensesAsync(businessId);
    }

    private void ResetPage() => page = 1;

    private void OnPageChanged(int newPage) => page = newPage;

    private void ClearFilters()
    {
        searchText = string.Empty;
        selectedStatus = string.Empty;
        startDate = null;
        page = 1;
    }
}