@page "/flocks/add"
@attribute [Authorize(Roles = "Admin,Manager")]
@using EggERP.Shared.Models
@using EggERP.Shared.Services
@inject IFlockApiService FlockApiService
@inject IProductApiService ProductApiService
@inject NavigationManager Navigation

<h3>Add Flock</h3>

<EditForm Model="@newFlock" OnValidSubmit="HandleSave">
    <div class="mb-3">
        <label>Name</label>
        <InputText class="form-control" @bind-Value="newFlock.Name" placeholder="e.g. White Layers A" />
    </div>

    <div class="mb-3">
        <label>Species</label>
        <select class="form-select" @bind="newFlock.Species">
            @foreach (var s in species)
            {
                <option value="@s">@s</option>
            }
        </select>
    </div>

    <div class="mb-3">
        <label>Breed (optional)</label>
        <InputText class="form-control" @bind-Value="newFlock.Breed" />
    </div>

    <div class="mb-3">
        <label>Placement Date</label>
        <InputDate class="form-control" @bind-Value="newFlock.PlacementDate" />
    </div>

    <div class="mb-3">
        <label>Initial Quantity</label>
        <InputNumber class="form-control" @bind-Value="newFlock.InitialQuantity" />
    </div>

    <div class="mb-3">
        <label>Initial Source</label>
        <select class="form-select" @bind="newFlock.InitialSource">
            <option value="Bought">Bought</option>
            <option value="Given">Given</option>
            <option value="Hatched">Hatched</option>
        </select>
    </div>

    <div class="mb-3">
        <label>Acquisition Cost (optional)</label>
        <InputNumber class="form-control" @bind-Value="newFlock.AcquisitionCost" />
    </div>

    <div class="mb-3">
        <label>Linked Egg Product (optional)</label>
        <select class="form-select" @bind="selectedProductId">
            <option value="">-- None --</option>
            @if (products is not null)
            {
                @foreach (var product in products)
                {
                    <option value="@product.Id">@product.Name</option>
                }
            }
        </select>
        <small class="form-text text-muted">Required only if you plan to record egg movements for this flock.</small>
    </div>

    <div class="mb-3">
        <label>Notes</label>
        <InputTextArea class="form-control" @bind-Value="newFlock.Notes" />
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <p style="color:red">@errorMessage</p>
    }

    <button type="submit" class="btn btn-primary">Save</button>
</EditForm>

@code {
    private readonly string[] species = { "Chicken", "Duck", "Quail", "Goose", "Other" };

    private CreateFlockRequest newFlock = new();
    private List<ProductDto>? products;
    private string selectedProductId = "";
    private string? errorMessage;

    private readonly Guid businessId = Guid.Parse("11111111-1111-1111-1111-111111111111");

    protected override async Task OnInitializedAsync()
    {
        products = await ProductApiService.GetProductsAsync(businessId);
    }

    private async Task HandleSave()
    {
        errorMessage = null;
        newFlock.LinkedProductId = Guid.TryParse(selectedProductId, out var pid) ? pid : null;

        var error = await FlockApiService.CreateFlockAsync(newFlock);
        if (error is not null)
        {
            errorMessage = error;
            return;
        }

        Navigation.NavigateTo("/flocks");
    }
}