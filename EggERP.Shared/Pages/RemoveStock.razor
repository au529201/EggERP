@page "/stock/remove"
@attribute [Authorize(Roles = "Admin,Manager")]
@using EggERP.Shared.Models
@using EggERP.Shared.Services
@inject IStockApiService StockApiService
@inject IProductApiService ProductApiService
@inject ICustomerApiService CustomerApiService
@inject IFlockApiService FlockApiService
@inject IEggApiService EggApiService
@inject IJSRuntime JsRuntime
@inject NavigationManager Navigation

<h3>Remove Stock</h3>

@if (products is null)
{
    <p>Loading...</p>
}
else
{
    <div class="table-responsive txn-table-scroll">
        <table class="table txn-table txn-table-stock">
            <thead>
                <tr>
                    <th class="txn-col-group">Group</th>
                    <th class="txn-col-product">Type / Product</th>
                    <th class="txn-col-qty">Quantity</th>
                    <th class="txn-col-stock">Stock</th>
                    <th class="txn-col-reason">Reason</th>
                    <th class="txn-col-party">Customer</th>
                    <th class="txn-col-money">Price</th>
                    <th class="txn-col-total">Total</th>
                    <th class="txn-col-action">Action</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var line in lines)
                {
                    <tr>
                        <td class="txn-col-group">
                            <select class="form-select"
                                    @bind="line.Group"
                                    @bind:after="() => OnGroupChanged(line)"
                                    disabled="@isSaving">
                                <option value="Flock">Flock</option>
                                <option value="Egg">Egg</option>
                            </select>
                        </td>

                        <td class="txn-col-product">
                            <select class="form-select"
                                    @bind="line.ProductId"
                                    @bind:after="() => OnProductChanged(line)"
                                    disabled="@isSaving">
                                <option value="">Select product</option>

                                @foreach (var product in AvailableProducts(line))
                                {
                                    <option value="@product.Id">
                                        @product.Type - @product.Description
                                    </option>
                                }
                            </select>
                        </td>

                        <td class="txn-col-qty">
                            <input type="number"
                                   step="1"
                                   min="1"
                                   max="9999"
                                   class="form-control"
                                   @bind="line.Quantity"
                                   disabled="@isSaving" />
                        </td>

                        <td class="txn-col-stock">
                            <span class="txn-stock-value">
                                @GetStock(line.ProductId).ToString("N0")
                            </span>
                        </td>

                        <td class="txn-col-reason">
                            <select class="form-select"
                                    @bind="line.Reason"
                                    disabled="@isSaving">
                                <option value="Sold">Sold</option>

                                @foreach (var reason in OutReasons(line.Group))
                                {
                                    <option value="@reason">
                                        @reason
                                    </option>
                                }
                            </select>
                        </td>

                        <td class="txn-col-party">
                            @if (line.Reason == "Sold")
                            {
                                <select class="form-select"
                                        @bind="line.CustomerId"
                                        disabled="@isSaving">
                                    <option value="">Walk-in</option>

                                    @foreach (var customer in customers ?? new())
                                    {
                                        <option value="@customer.Id">
                                            @customer.Name
                                        </option>
                                    }
                                </select>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>

                        <td class="txn-col-money">
                            @if (line.Reason == "Sold")
                            {
                                <input type="number"
                                       step="0.01"
                                       min="0"
                                       class="form-control"
                                       @bind="line.UnitPrice"
                                       disabled="@isSaving" />
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>

                        <td class="txn-col-total">
                            @if (line.Reason == "Sold")
                            {
                                @((line.Quantity * line.UnitPrice).ToString("N2"))
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>

                        <td class="txn-col-action">
                            <button type="button"
                                    class="btn btn-sm btn-danger"
                                    @onclick="() => RemoveLine(line)"
                                    disabled="@isSaving">
                                Remove
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <button type="button"
            class="btn btn-secondary"
            @onclick="AddLine"
            disabled="@(isSaving || !CanAddLine())">
        + Add Line
    </button>

    @if (HasPaymentLine)
    {
        <h5 class="txn-total">
            Sold Total: @TotalSale.ToString("N2")
        </h5>
    }

    <div class="txn-row">
        @if (HasPaymentLine)
        {
            <div class="txn-field">
                <label>Status</label>
                <select class="form-select"
                        @bind="status"
                        disabled="@isSaving">
                    <option value="Paid">Paid</option>
                    <option value="Pending">Pending</option>
                </select>
            </div>

            <div class="txn-field">
                <label>Payment Method</label>
                <select class="form-select"
                        @bind="paymentMethod"
                        @bind:after="OnPaymentMethodChanged"
                        disabled="@isSaving">
                    <option value="Cash">Cash</option>
                    <option value="Credit Card">Credit Card</option>
                    <option value="Debit Card">Debit Card</option>
                    <option value="Other">Other</option>
                </select>
            </div>

            <div class="txn-field">
                <label>Bank Name / Payment Source</label>
                <input class="form-control"
                       @bind="bankName"
                       placeholder="e.g. BDO, GCash, Maya"
                       disabled="@(isSaving || paymentMethod == "Cash")" />
            </div>

            <div class="txn-field">
                <label>Reference ID</label>
                <input class="form-control"
                       @bind="referenceNumber"
                       placeholder="Required for non-cash"
                       disabled="@(isSaving || paymentMethod == "Cash")" />
            </div>
        }

        <div class="txn-field">
            <label>Date</label>
            <input type="date"
                   class="form-control"
                   @bind="movementDate"
                   disabled="@isSaving" />
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">
            @errorMessage
        </div>
    }

    <div class="txn-bottom-row">
        <div class="txn-notes">
            <label>Notes</label>
            <textarea class="form-control"
                      rows="1"
                      @bind="notes"
                      placeholder="Optional transaction notes..."
                      disabled="@isSaving"></textarea>
        </div>

        <div class="txn-actions">
            <button type="button"
                    class="btn btn-outline-secondary"
                    @onclick="Cancel"
                    disabled="@isSaving">
                Cancel
            </button>

            <button type="button"
                    class="btn btn-primary"
                    @onclick="HandleSave"
                    disabled="@isSaving">
                @(isSaving ? "Processing..." : "Complete Transaction")
            </button>
        </div>
    </div>
}

@code {
    private class Line
    {
        public string Group { get; set; } = "Flock";
        public string ProductId { get; set; } = string.Empty;
        public int Quantity { get; set; } = 1;
        public string Reason { get; set; } = "Moved";
        public decimal UnitPrice { get; set; }
        public string CustomerId { get; set; } = string.Empty;
    }

    private readonly string[] flockOutReasons =
    {
        "Moved",
        "Died",
        "Missing",
        "Culled"
    };

    private readonly string[] eggOutReasons =
    {
        "Moved",
        "Broken",
        "Stolen",
        "Missing",
        "Hatched"
    };

    private List<ProductDto>? products;
    private List<CustomerDto>? customers;
    private List<Line> lines = new();
    private Dictionary<Guid, int> stockOnHand = new();

    private string status = "Paid";
    private string paymentMethod = "Cash";

    private string? bankName;
    private string? referenceNumber;
    private string? notes;
    private string? errorMessage;

    private DateTime movementDate = DateTime.Today;
    private bool isSaving;

    private readonly Guid businessId =
        Guid.Parse("11111111-1111-1111-1111-111111111111");

    private bool HasPaymentLine =>
        lines.Any(l => l.Reason == "Sold");

    private decimal TotalSale =>
        lines
            .Where(l => l.Reason == "Sold")
            .Sum(l => l.Quantity * l.UnitPrice);

    protected override async Task OnInitializedAsync()
    {
        products =
            await ProductApiService.GetProductsAsync();

        customers =
            await CustomerApiService
                .GetCustomersAsync(businessId);

        var flockBoard =
            await FlockApiService.GetBoardAsync();

        var eggBoard =
            await EggApiService.GetBoardAsync();

        foreach (var row in flockBoard.Concat(eggBoard))
        {
            stockOnHand[row.ProductId] =
                row.Available;
        }

        lines.Add(new Line());
    }

    private int GetStock(string productId)
    {
        if (!Guid.TryParse(productId, out var id))
            return 0;

        return stockOnHand.TryGetValue(id, out var stock)
            ? stock
            : 0;
    }

    private string[] OutReasons(string group)
    {
        return group == "Flock"
            ? flockOutReasons
            : eggOutReasons;
    }

    private IEnumerable<ProductDto> AvailableProducts(Line current)
    {
        var takenIds =
            lines
                .Where(l =>
                    l != current &&
                    !string.IsNullOrWhiteSpace(l.ProductId))
                .Select(l => l.ProductId)
                .ToHashSet();

        return (products ?? new())
            .Where(p =>
                p.Group == current.Group &&
                !takenIds.Contains(p.Id.ToString()));
    }

    private bool CanAddLine()
    {
        return lines.Count <
               (products?.Count ?? 0);
    }

    private void OnGroupChanged(Line line)
    {
        line.ProductId = string.Empty;
        line.Reason = OutReasons(line.Group)[0];
        line.CustomerId = string.Empty;
        line.UnitPrice = 0;
    }

    private void OnProductChanged(Line line)
    {
        if (!Guid.TryParse(
                line.ProductId,
                out var productId))
        {
            return;
        }

        var product =
            products?.FirstOrDefault(
                p => p.Id == productId);

        if (product is not null)
        {
            line.UnitPrice =
                product.SellingPrice;
        }
    }

    private void AddLine()
    {
        if (isSaving || !CanAddLine())
            return;

        lines.Add(
            new Line
            {
                Reason = OutReasons("Flock")[0]
            });
    }

    private void RemoveLine(Line line)
    {
        if (isSaving)
            return;

        lines.Remove(line);

        if (lines.Count == 0)
            lines.Add(new Line());
    }

    private void OnPaymentMethodChanged()
    {
        if (paymentMethod == "Cash")
        {
            bankName = null;
            referenceNumber = null;
        }
    }

    private async Task Cancel()
    {
        if (isSaving)
            return;

        var confirmed =
            await JsRuntime.InvokeAsync<bool>(
                "confirm",
                "Discard this entry and go back? Unsaved changes will be lost.");

        if (confirmed)
            Navigation.NavigateTo("/eggs");
    }

    private async Task HandleSave()
    {
        if (isSaving)
            return;

        errorMessage = null;

        var enteredLines =
            lines
                .Where(l =>
                    !string.IsNullOrWhiteSpace(l.ProductId))
                .ToList();

        if (enteredLines.Count == 0)
        {
            errorMessage =
                "Add at least one valid line item.";
            return;
        }

        if (enteredLines.Any(l => l.Quantity <= 0))
        {
            errorMessage =
                "Quantity must be greater than zero.";
            return;
        }

        if (enteredLines.Any(l => l.Quantity > 9999))
        {
            errorMessage =
                "Quantity cannot exceed 9,999 per line.";
            return;
        }

        if (enteredLines
            .Where(l => l.Reason == "Sold")
            .Any(l => l.UnitPrice < 0))
        {
            errorMessage =
                "Unit price cannot be negative.";
            return;
        }

        foreach (var line in enteredLines)
        {
            if (!Guid.TryParse(
                    line.ProductId,
                    out var productId))
            {
                errorMessage =
                    "One or more selected products are invalid.";
                return;
            }

            var available =
                stockOnHand.TryGetValue(
                    productId,
                    out var quantity)
                    ? quantity
                    : 0;

            if (line.Quantity > available)
            {
                errorMessage =
                    $"Cannot remove {line.Quantity:N0}. Only {available:N0} currently in stock for the selected product.";
                return;
            }
        }

        if (HasPaymentLine &&
            status != "Paid" &&
            status != "Pending")
        {
            errorMessage =
                "Status must be Paid or Pending.";
            return;
        }

        if (HasPaymentLine &&
            paymentMethod != "Cash" &&
            (string.IsNullOrWhiteSpace(bankName) ||
             string.IsNullOrWhiteSpace(referenceNumber)))
        {
            errorMessage =
                "Bank Name / Payment Source and Reference ID are required for non-cash payments.";
            return;
        }

        isSaving = true;

        try
        {
            var request =
                new ProcessStockTransactionRequest
                {
                    BusinessId = businessId,
                    Direction = "Out",
                    MovementDate = movementDate,

                    Notes =
                        string.IsNullOrWhiteSpace(notes)
                            ? null
                            : notes.Trim(),

                    Status = status,
                    PaymentMethod = paymentMethod,

                    PaymentSource =
                        HasPaymentLine &&
                        paymentMethod != "Cash"
                            ? bankName?.Trim()
                            : null,

                    ReferenceNumber =
                        HasPaymentLine &&
                        paymentMethod != "Cash"
                            ? referenceNumber?.Trim()
                            : null,

                    BankName =
                        HasPaymentLine &&
                        paymentMethod != "Cash"
                            ? bankName?.Trim()
                            : null,

                    Lines =
                        enteredLines.Select(l =>
                            new StockTransactionLineRequest
                            {
                                Group = l.Group,
                                ProductId = Guid.Parse(l.ProductId),
                                Reason = l.Reason,
                                Quantity = l.Quantity,
                                UnitPrice = l.UnitPrice,

                                CustomerId =
                                    Guid.TryParse(
                                        l.CustomerId,
                                        out var customerId)
                                        ? customerId
                                        : null
                            }).ToList()
                };

            var error =
                await StockApiService.ProcessAsync(request);

            if (error is not null)
            {
                errorMessage = error;
                return;
            }

            Navigation.NavigateTo("/eggs");
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Failed to complete transaction: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }
}