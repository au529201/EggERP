@page "/stock/remove"
@attribute [Authorize(Roles = "Admin,Manager")]
@using EggERP.Shared.Models
@using EggERP.Shared.Services
@inject IStockApiService StockApiService
@inject IProductApiService ProductApiService
@inject ICustomerApiService CustomerApiService
@inject NavigationManager Navigation

<h3>Remove Stock</h3>

@if (products is null)
{
    <p>Loading...</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Group</th>
                <th>Type</th>
                <th>Quantity</th>
                <th>Reason</th>
                <th>Customer</th>
                <th>Price</th>
                <th>Total</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var line in lines)
            {
                <tr>
                    <td>
                        <select class="form-select" @bind="line.Group" @bind:after="() => OnGroupChanged(line)">
                            <option value="Flock">Flock</option>
                            <option value="Egg">Egg</option>
                        </select>
                    </td>
                    <td>
                        <select class="form-select" @bind="line.ProductId" @bind:after="() => OnProductChanged(line)">
                            <option value="">Select product</option>
                            @foreach (var product in AvailableProducts(line))
                            {
                                <option value="@product.Id">@product.Type - @product.Description</option>
                            }
                        </select>
                    </td>
                    <td>
                        <input type="number" step="1" min="1" class="form-control" @bind="line.Quantity" />
                    </td>
                    <td>
                        <select class="form-select" @bind="line.Reason">
                            <option value="Sold">Sold</option>
                            @foreach (var r in OutReasons(line.Group))
                            {
                                <option value="@r">@r</option>
                            }
                        </select>
                    </td>
                    <td>
                        @if (line.Reason == "Sold")
                        {
                            <select class="form-select" @bind="line.CustomerId">
                                <option value="">Walk-in</option>
                                @foreach (var c in customers ?? new())
                                {
                                    <option value="@c.Id">@c.Name</option>
                                }
                            </select>
                        }
                    </td>
                    <td>
                        @if (line.Reason == "Sold")
                        {
                            <input type="number" step="0.01" class="form-control" @bind="line.UnitPrice" />
                        }
                    </td>
                    <td>
                        @if (line.Reason == "Sold")
                        {
                            @((line.Quantity * line.UnitPrice).ToString("N2"))
                        }
                    </td>
                    <td>
                        <button class="btn btn-sm btn-danger" @onclick="() => RemoveLine(line)">Remove</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <button class="btn btn-secondary mb-3" @onclick="AddLine" disabled="@(!CanAddLine())">+ Add Line</button>

    @if (HasPaymentLine)
    {
        <h5>Total Sale Amount (Sold): @(lines.Where(l => l.Reason == "Sold").Sum(l => l.Quantity * l.UnitPrice)).ToString("N2")</h5>

        <div class="row mb-3" style="max-width:700px;">
            <div class="col-md-4">
                <label>Status</label>
                <select class="form-select" @bind="status">
                    <option value="Paid">Paid</option>
                    <option value="Pending">Pending</option>
                </select>
            </div>
            <div class="col-md-4">
                <label>Payment Method</label>
                <select class="form-select" @bind="paymentMethod">
                    <option value="Cash">Cash</option>
                    <option value="Credit Card">Credit Card</option>
                    <option value="Debit Card">Debit Card</option>
                    <option value="Other">Other</option>
                </select>
            </div>
        </div>

        @if (paymentMethod != "Cash")
        {
            <div class="row mb-3" style="max-width:700px;">
                <div class="col-md-4">
                    <label>Bank Name</label>
                    <input class="form-control" @bind="bankName" />
                </div>
                <div class="col-md-4">
                    <label>Reference ID</label>
                    <input class="form-control" @bind="referenceNumber" />
                </div>
            </div>
        }
    }

    <div class="mb-3" style="max-width:400px;">
        <label>Date</label>
        <input type="date" class="form-control" @bind="movementDate" />
    </div>
    <div class="mb-3" style="max-width:600px;">
        <label>Notes</label>
        <textarea class="form-control" @bind="notes"></textarea>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <p style="color:red">@errorMessage</p>
    }

    <button class="btn btn-primary" @onclick="HandleSave">Complete Transaction</button>
}

@code {
    private class Line
    {
        public string Group { get; set; } = "Flock";
        public string ProductId { get; set; } = string.Empty;
        public int Quantity { get; set; } = 1;
        public string Reason { get; set; } = "Moved";
        public decimal UnitPrice { get; set; }
        public string CustomerId { get; set; } = string.Empty;
    }

    private readonly string[] flockOutReasons = { "Moved", "Died", "Missing", "Culled" };
    private readonly string[] eggOutReasons = { "Moved", "Broken", "Stolen", "Missing", "Hatched" };

    private List<ProductDto>? products;
    private List<CustomerDto>? customers;
    private List<Line> lines = new();

    private string status = "Paid";
    private string paymentMethod = "Cash";
    private string? bankName;
    private string? referenceNumber;
    private DateTime movementDate = DateTime.Today;
    private string? notes;
    private string? errorMessage;

    private readonly Guid businessId = Guid.Parse("11111111-1111-1111-1111-111111111111");

    private bool HasPaymentLine => lines.Any(l => l.Reason == "Sold");

    protected override async Task OnInitializedAsync()
    {
        products = await ProductApiService.GetProductsAsync(businessId);
        customers = await CustomerApiService.GetCustomersAsync(businessId);
        lines.Add(new Line());
    }

    private string[] OutReasons(string group) => group == "Flock" ? flockOutReasons : eggOutReasons;

    private IEnumerable<ProductDto> AvailableProducts(Line current)
    {
        var takenIds = lines.Where(l => l != current && !string.IsNullOrEmpty(l.ProductId))
                             .Select(l => l.ProductId).ToHashSet();
        return (products ?? new()).Where(p => p.Group == current.Group && !takenIds.Contains(p.Id.ToString()));
    }

    private bool CanAddLine() => lines.Count < (products?.Count ?? 0);

    private void OnGroupChanged(Line line)
    {
        line.ProductId = string.Empty;
        line.Reason = OutReasons(line.Group)[0];
    }

    private void OnProductChanged(Line line)
    {
        if (Guid.TryParse(line.ProductId, out var pid))
        {
            var product = products?.FirstOrDefault(p => p.Id == pid);
            if (product is not null) line.UnitPrice = product.SellingPrice;
        }
    }

    private void AddLine() => lines.Add(new Line { Reason = OutReasons("Flock")[0] });
    private void RemoveLine(Line line) => lines.Remove(line);

    private async Task HandleSave()
    {
        errorMessage = null;

        var validLines = lines.Where(l => !string.IsNullOrEmpty(l.ProductId) && l.Quantity > 0).ToList();
        if (validLines.Count == 0)
        {
            errorMessage = "Add at least one valid line item.";
            return;
        }

        if (HasPaymentLine && paymentMethod != "Cash" &&
            (string.IsNullOrWhiteSpace(bankName) || string.IsNullOrWhiteSpace(referenceNumber)))
        {
            errorMessage = "Bank Name and Reference ID are required for non-cash payments.";
            return;
        }

        var request = new ProcessStockTransactionRequest
        {
            BusinessId = businessId,
            Direction = "Out",
            MovementDate = movementDate,
            Notes = notes,
            Status = status,
            PaymentMethod = paymentMethod,
            PaymentSource = paymentMethod == "Cash" ? null : paymentMethod,
            ReferenceNumber = paymentMethod == "Cash" ? null : referenceNumber,
            BankName = paymentMethod == "Cash" ? null : bankName,
            Lines = validLines.Select(l => new StockTransactionLineRequest
            {
                Group = l.Group,
                ProductId = Guid.Parse(l.ProductId),
                Reason = l.Reason,
                Quantity = l.Quantity,
                UnitPrice = l.UnitPrice,
                CustomerId = Guid.TryParse(l.CustomerId, out var cid) ? cid : null
            }).ToList()
        };

        var error = await StockApiService.ProcessAsync(request);
        if (error is not null)
        {
            errorMessage = error;
            return;
        }

        Navigation.NavigateTo("/eggs");
    }
}