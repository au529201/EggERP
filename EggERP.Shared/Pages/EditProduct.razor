@page "/products/edit/{Id:guid}"
@using EggERP.Shared.Models
@using EggERP.Shared.Services
@inject IProductApiService ProductApiService
@inject NavigationManager Navigation

<h3>Edit Product</h3>

@if (isLoading)
{
    <p>Loading...</p>
}
else if (notFound)
{
    <p>Product not found.</p>
}
else
{
    <EditForm Model="@editModel" OnValidSubmit="HandleSave">
        <div class="mb-3">
            <label>Group</label>
            <select class="form-select" @bind="editModel.Group">
                <option value="Flock">Flock</option>
                <option value="Egg">Egg</option>
            </select>
        </div>

        <div class="mb-3">
            <label>Type</label>
            <InputText class="form-control"
                       @bind-Value="editModel.Type" />
        </div>

        <div class="mb-3">
            <label>Description</label>
            <InputText class="form-control"
                       @bind-Value="editModel.Description" />
        </div>

        <div class="mb-3">
            <label>Unit</label>
            <InputText class="form-control"
                       @bind-Value="editModel.Unit" />
        </div>

        <div class="mb-3">
            <label>Cost Price</label>
            <InputNumber class="form-control"
                         @bind-Value="editModel.CostPrice" />
        </div>

        <div class="mb-3">
            <label>Sell Price</label>
            <InputNumber class="form-control"
                         @bind-Value="editModel.SellingPrice" />
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <p style="color:red">@errorMessage</p>
        }

<button type="submit"
        class="btn btn-primary"
        disabled="@isSaving">
    @(isSaving ? "Saving..." : "Save")
</button>
    </EditForm>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private readonly Guid businessId =
        Guid.Parse("11111111-1111-1111-1111-111111111111");

    private UpdateProductRequest editModel = new();

private bool isLoading = true;
private bool notFound = false;
private bool isSaving = false;

private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        var product =
await ProductApiService.GetProductByIdAsync(Id);
        if (product is null)
        {
            notFound = true;
            isLoading = false;
            return;
        }

        editModel = new UpdateProductRequest
        {
            Id = product.Id,
            BusinessId = businessId,
            CategoryId = product.CategoryId,
            Group = product.Group,
            Type = product.Type,
            Description = product.Description,
            CostPrice = product.CostPrice,
            SellingPrice = product.SellingPrice,
            Unit = product.Unit,
            IsActive = true
        };

        isLoading = false;
    }

private async Task HandleSave()
{
    if (isSaving)
    {
        return;
    }

    errorMessage = null;

    if (string.IsNullOrWhiteSpace(editModel.Type))
    {
        errorMessage = "Type is required.";
        return;
    }

    if (string.IsNullOrWhiteSpace(editModel.Unit))
    {
        errorMessage = "Unit is required.";
        return;
    }

    if (editModel.CostPrice < 0)
    {
        errorMessage = "Cost Price cannot be negative.";
        return;
    }

    if (editModel.SellingPrice < 0)
    {
        errorMessage = "Sell Price cannot be negative.";
        return;
    }

    isSaving = true;

    try
    {
        await ProductApiService.UpdateProductAsync(editModel);
        Navigation.NavigateTo("/products");
    }
    catch (Exception ex)
    {
        errorMessage = $"Failed to save product: {ex.Message}";
        isSaving = false;
    }
}
}