@page "/products/edit/{Id:guid}"
@using EggERP.Shared.Models
@using EggERP.Shared.Services
@inject IProductApiService ProductApiService
@inject NavigationManager Navigation

<h3>Edit Product</h3>

@if (isLoading)
{
    <p>Loading...</p>
}
else if (notFound)
{
    <p>Product not found.</p>
}
else
{
    <EditForm Model="@editModel" OnValidSubmit="HandleSave">
        <div class="mb-3">
            <label>Category ID</label>
            <InputText class="form-control" @bind-Value="editModel.CategoryId" />
        </div>
        <div class="mb-3">
            <label>Name</label>
            <InputText class="form-control" @bind-Value="editModel.Name" />
        </div>
        <div class="mb-3">
            <label>SKU</label>
            <InputText class="form-control" @bind-Value="editModel.Sku" />
        </div>
        <div class="mb-3">
            <label>Description</label>
            <InputText class="form-control" @bind-Value="editModel.Description" />
        </div>
        <div class="mb-3">
            <label>Unit</label>
            <InputText class="form-control" @bind-Value="editModel.Unit" />
        </div>
        <div class="mb-3">
            <label>Cost Price</label>
            <InputNumber class="form-control" @bind-Value="editModel.CostPrice" />
        </div>
        <div class="mb-3">
            <label>Selling Price</label>
            <InputNumber class="form-control" @bind-Value="editModel.SellingPrice" />
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <p style="color:red">@errorMessage</p>
        }

        <button type="submit" class="btn btn-primary">Save</button>
    </EditForm>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private ProductFormModel editModel = new();
    private bool isLoading = true;
    private bool notFound = false;
    private string? errorMessage;

    // Hard-coded test business ID for now, until auth/business context exists
    private readonly Guid businessId = Guid.Parse("11111111-1111-1111-1111-111111111111");

    protected override async Task OnInitializedAsync()
    {
        var product = await ProductApiService.GetProductByIdAsync(businessId, Id);

        if (product is null)
        {
            notFound = true;
            isLoading = false;
            return;
        }

        editModel = new ProductFormModel
        {
            CategoryId = product.CategoryId.ToString(),
            Name = product.Name,
            Sku = product.Sku,
            Description = product.Description ?? string.Empty,
            Unit = product.Unit,
            CostPrice = product.CostPrice,
            SellingPrice = product.SellingPrice
        };

        isLoading = false;
    }

    private async Task HandleSave()
    {
        errorMessage = null;

        if (!Guid.TryParse(editModel.CategoryId, out var categoryId))
        {
            errorMessage = "Category ID must be a valid GUID.";
            return;
        }

        var request = new UpdateProductRequest
        {
            Id = Id,
            BusinessId = businessId,
            CategoryId = categoryId,
            Name = editModel.Name,
            Sku = editModel.Sku,
            Description = editModel.Description,
            Unit = editModel.Unit,
            CostPrice = editModel.CostPrice,
            SellingPrice = editModel.SellingPrice,
            IsActive = true
        };

        try
        {
            await ProductApiService.UpdateProductAsync(request);
            Navigation.NavigateTo("/products");
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to save product: {ex.Message}";
        }
    }

    private class ProductFormModel
    {
        public string CategoryId { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string Sku { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public string Unit { get; set; } = string.Empty;
        public decimal CostPrice { get; set; }
        public decimal SellingPrice { get; set; }
    }
}