@page "/sales"
@attribute [Authorize(Roles = "Admin,Manager,Staff")]
@using EggERP.Shared.Models
@using EggERP.Shared.Services
@inject ISaleApiService SaleApiService
@inject ICustomerApiService CustomerApiService
@inject IJSRuntime JsRuntime

<h3>Sales</h3>

<a class="btn btn-primary mb-3" href="/sales/new">
    + New Sale
</a>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">
        @errorMessage
    </div>
}

<div class="row mb-3 g-2">
    <div class="col-md-4">
        <label>Search</label>
        <input class="form-control"
               placeholder="Customer name..."
               @bind="searchText"
               @bind:event="oninput"
               @bind:after="ResetPage" />
    </div>

    <div class="col-md-2">
        <label>Status</label>
        <select class="form-select"
                @bind="selectedStatus"
                @bind:after="ResetPage">
            <option value="">All</option>
            <option value="Paid">Paid</option>
            <option value="Pending">Pending</option>
        </select>
    </div>

    <div class="col-md-2">
        <label>From</label>
        <input type="date"
               class="form-control"
               @bind="startDate"
               @bind:after="ResetPage" />
    </div>

    <div class="col-md-2">
        <label>To</label>
        <input type="date"
               class="form-control"
               @bind="endDate"
               @bind:after="ResetPage" />
    </div>

    <div class="col-md-2 d-flex align-items-end">
        <button class="btn btn-outline-secondary w-100"
                @onclick="ClearFilters">
            Clear
        </button>
    </div>
</div>

@if (sales is null)
{
    <p>Loading...</p>
}
else if (!FilteredSales.Any())
{
    <p>No matching sales found.</p>
}
else
{
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Customer</th>
                    <th>Total</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var sale in PagedSales)
                {
                    <tr>
                        <td>
                            @sale.SaleDateUtc.ToLocalTime().ToString("g")
                        </td>

                        <td>
                            @GetCustomerName(sale.CustomerId)
                        </td>

                        <td>
                            @sale.TotalAmount.ToString("N2")
                        </td>

                        <td>
                            @if (sale.Status == "Paid")
                            {
                                <span class="badge bg-success">
                                    Paid
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">
                                    @sale.Status
                                </span>
                            }
                        </td>

                        <td>
                            @if (sale.Status == "Pending")
                            {
                                <button class="btn btn-sm btn-success"
                                        disabled="@isUpdating"
                                        @onclick="() => MarkAsPaid(sale)">
                                    @(isUpdating ? "Processing..." : "Mark Paid")
                                </button>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <Pager Total="FilteredSales.Count()"
           Page="page"
           PageSize="pageSize"
           PageChanged="OnPageChanged" />
}

@code {
    private List<SaleDto>? sales;
    private List<CustomerDto>? customers;

    private string searchText = string.Empty;
    private string selectedStatus = string.Empty;
    private DateTime? startDate;
    private DateTime? endDate;

    private readonly Guid businessId =
        Guid.Parse("11111111-1111-1111-1111-111111111111");

    private int page = 1;
    private const int pageSize = 7;

    private bool isUpdating;
    private string? errorMessage;

    private IEnumerable<SaleDto> FilteredSales =>
        (sales ?? new List<SaleDto>())
        .Where(s =>
            (
                string.IsNullOrWhiteSpace(searchText) ||
                GetCustomerName(s.CustomerId)
                    .Contains(searchText, StringComparison.OrdinalIgnoreCase)
            )
            &&
            (
                string.IsNullOrWhiteSpace(selectedStatus) ||
                s.Status == selectedStatus
            )
            &&
            (
                !startDate.HasValue ||
                s.SaleDateUtc.ToLocalTime().Date >= startDate.Value.Date
            )
            &&
            (
                !endDate.HasValue ||
                s.SaleDateUtc.ToLocalTime().Date <= endDate.Value.Date
            ));

    private IEnumerable<SaleDto> PagedSales =>
        FilteredSales
            .Skip((page - 1) * pageSize)
            .Take(pageSize);

    protected override async Task OnInitializedAsync()
    {
        sales = await SaleApiService.GetSalesAsync(businessId);
        customers = await CustomerApiService.GetCustomersAsync(businessId);
    }

    private string GetCustomerName(Guid? customerId)
    {
        if (customerId is null)
        {
            return "Walk-in";
        }

        return customers?
            .FirstOrDefault(c => c.Id == customerId)?
            .Name ?? "Unknown";
    }

    private void ResetPage()
    {
        page = 1;
    }

    private void OnPageChanged(int newPage)
    {
        page = newPage;
    }

    private void ClearFilters()
    {
        searchText = string.Empty;
        selectedStatus = string.Empty;
        startDate = null;
        endDate = null;
        page = 1;
    }

    private async Task MarkAsPaid(SaleDto sale)
    {
        if (isUpdating)
        {
            return;
        }

        errorMessage = null;

        var confirmed = await JsRuntime.InvokeAsync<bool>(
            "confirm",
            $"Mark this sale of {sale.TotalAmount:N2} as fully paid in Cash?");

        if (!confirmed)
        {
            return;
        }

        isUpdating = true;

        try
        {
            await SaleApiService.MarkAsPaidAsync(
                businessId,
                sale.Id,
                "Cash",
                null,
                null);

            sales = await SaleApiService.GetSalesAsync(businessId);

            var totalPages = Math.Max(
                1,
                (int)Math.Ceiling(FilteredSales.Count() / (double)pageSize));

            if (page > totalPages)
            {
                page = totalPages;
            }
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Failed to update payment: {ex.Message}";
        }
        finally
        {
            isUpdating = false;
        }
    }
}