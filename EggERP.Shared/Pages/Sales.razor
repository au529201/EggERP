@page "/sales"
@attribute [Authorize(Roles = "Admin,Manager,Staff")]
@using EggERP.Shared.Models
@using EggERP.Shared.Services
@inject ISaleApiService SaleApiService
@inject ICustomerApiService CustomerApiService
@inject IJSRuntime JsRuntime

<h3>Sales</h3>

<a class="btn btn-primary mb-3" href="/sales/new">
    + New Sale
</a>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">
        @errorMessage
    </div>
}

@if (sales is null)
{
    <p>Loading...</p>
}
else if (sales.Count == 0)
{
    <p>No sales found.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Date</th>
                <th>Customer</th>
                <th>Total</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var sale in PagedSales)
            {
                <tr>
                    <td>
                        @sale.SaleDateUtc.ToLocalTime().ToString("g")
                    </td>

                    <td>
                        @GetCustomerName(sale.CustomerId)
                    </td>

                    <td>
                        @sale.TotalAmount.ToString("N2")
                    </td>

                    <td>
                        @if (sale.Status == "Paid")
                        {
                            <span class="badge bg-success">
                                Paid
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">
                                @sale.Status
                            </span>
                        }
                    </td>

                    <td>
                        @if (sale.Status == "Pending")
                        {
                            <button class="btn btn-sm btn-success"
                                    disabled="@isUpdating"
                                    @onclick="() => MarkAsPaid(sale)">
                                @(isUpdating ? "Processing..." : "Mark Paid")
                            </button>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <Pager Total="sales.Count"
           Page="page"
           PageSize="pageSize"
           PageChanged="OnPageChanged" />
}

@code {
    private List<SaleDto>? sales;
    private List<CustomerDto>? customers;

    private readonly Guid businessId =
        Guid.Parse("11111111-1111-1111-1111-111111111111");

    private int page = 1;
    private const int pageSize = 7;

    private bool isUpdating;
    private string? errorMessage;

    private IEnumerable<SaleDto> PagedSales =>
        (sales ?? new List<SaleDto>())
            .Skip((page - 1) * pageSize)
            .Take(pageSize);

    private void OnPageChanged(int newPage)
    {
        page = newPage;
    }

    protected override async Task OnInitializedAsync()
    {
        sales = await SaleApiService.GetSalesAsync(businessId);
        customers = await CustomerApiService.GetCustomersAsync(businessId);
    }

    private string GetCustomerName(Guid? customerId)
    {
        if (customerId is null)
        {
            return "Walk-in";
        }

        return customers?
            .FirstOrDefault(c => c.Id == customerId)?
            .Name ?? "Unknown";
    }

    private async Task MarkAsPaid(SaleDto sale)
    {
        if (isUpdating)
        {
            return;
        }

        errorMessage = null;

        var confirmed = await JsRuntime.InvokeAsync<bool>(
            "confirm",
            $"Mark this sale of {sale.TotalAmount:N2} as fully paid in Cash?");

        if (!confirmed)
        {
            return;
        }

        isUpdating = true;

        try
        {
            await SaleApiService.MarkAsPaidAsync(
                businessId,
                sale.Id,
                "Cash",
                null,
                null);

            sales = await SaleApiService.GetSalesAsync(businessId);
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Failed to update payment: {ex.Message}";
        }
        finally
        {
            isUpdating = false;
        }
    }
}