@page "/suppliers/add"
@attribute [Authorize(Roles = "Admin,Manager,Staff")]

@using EggERP.Shared.Models
@using EggERP.Shared.Services

@inject ISupplierApiService SupplierApiService
@inject CurrentBusinessService CurrentBusinessService
@inject NavigationManager Navigation

<h3>Add Supplier</h3>

<EditForm Model="@newSupplier" OnValidSubmit="HandleSave">
    <div class="mb-3">
        <label class="form-label">Name</label>
        <InputText class="form-control"
                   @bind-Value="newSupplier.Name" />
    </div>

    <div class="mb-3">
        <label class="form-label">Contact Person</label>
        <InputText class="form-control"
                   @bind-Value="newSupplier.ContactPerson" />
    </div>

    <div class="mb-3">
        <label class="form-label">Email</label>
        <InputText class="form-control"
                   @bind-Value="newSupplier.Email" />
    </div>

    <div class="mb-3">
        <label class="form-label">Phone</label>
        <InputText class="form-control"
                   @bind-Value="newSupplier.Phone" />
    </div>

    <div class="mb-3">
        <label class="form-label">Address</label>
        <InputText class="form-control"
                   @bind-Value="newSupplier.Address" />
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">
            @errorMessage
        </div>
    }

    <div class="d-flex gap-2">
        <button type="submit"
                class="btn btn-primary"
                disabled="@isSaving">
            @(isSaving ? "Saving..." : "Save")
        </button>

        <button type="button"
                class="btn btn-secondary"
                disabled="@isSaving"
                @onclick="Cancel">
            Cancel
        </button>
    </div>
</EditForm>

@code {
    private SupplierFormModel newSupplier = new();
    private string? errorMessage;
    private bool isSaving;

    private async Task HandleSave()
    {
        if (isSaving)
            return;

        errorMessage = null;

        if (string.IsNullOrWhiteSpace(newSupplier.Name))
        {
            errorMessage = "Supplier name is required.";
            return;
        }

        isSaving = true;

        try
        {
            var businessId =
                await CurrentBusinessService.GetBusinessIdAsync();

            if (businessId == Guid.Empty)
            {
                errorMessage = "Unable to identify the current business.";
                return;
            }

            var request = new CreateSupplierRequest
            {
                BusinessId = businessId,
                Name = newSupplier.Name.Trim(),
                ContactPerson =
                    string.IsNullOrWhiteSpace(newSupplier.ContactPerson)
                        ? null
                        : newSupplier.ContactPerson.Trim(),
                Email = string.IsNullOrWhiteSpace(newSupplier.Email)
                    ? null
                    : newSupplier.Email.Trim(),
                Phone = string.IsNullOrWhiteSpace(newSupplier.Phone)
                    ? null
                    : newSupplier.Phone.Trim(),
                Address = string.IsNullOrWhiteSpace(newSupplier.Address)
                    ? null
                    : newSupplier.Address.Trim(),
                IsActive = true
            };

            await SupplierApiService.CreateSupplierAsync(request);

            Navigation.NavigateTo("/suppliers");
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to save supplier: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/suppliers");
    }

    private class SupplierFormModel
    {
        public string Name { get; set; } = string.Empty;
        public string ContactPerson { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Phone { get; set; } = string.Empty;
        public string Address { get; set; } = string.Empty;
    }
}
