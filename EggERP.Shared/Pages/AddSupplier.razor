@page "/suppliers/add"
@attribute [Authorize(Roles = "Admin,Manager")]
@using EggERP.Shared.Models
@using EggERP.Shared.Services
@inject ISupplierApiService SupplierApiService
@inject NavigationManager Navigation

<h3>Add Supplier</h3>

<EditForm Model="@newSupplier" OnValidSubmit="HandleSave">
    <div class="mb-3">
        <label>Name</label>
        <InputText class="form-control" @bind-Value="newSupplier.Name" />
    </div>
    <div class="mb-3">
        <label>Contact Person</label>
        <InputText class="form-control" @bind-Value="newSupplier.ContactPerson" />
    </div>
    <div class="mb-3">
        <label>Email</label>
        <InputText class="form-control" @bind-Value="newSupplier.Email" />
    </div>
    <div class="mb-3">
        <label>Phone</label>
        <InputText class="form-control" @bind-Value="newSupplier.Phone" />
    </div>
    <div class="mb-3">
        <label>Address</label>
        <InputText class="form-control" @bind-Value="newSupplier.Address" />
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <p style="color:red">@errorMessage</p>
    }
<button type="submit"
        class="btn btn-primary"
        disabled="@isSaving">
    @(isSaving ? "Saving..." : "Save")
</button>
</EditForm>

@code {
private SupplierFormModel newSupplier = new();
private string? errorMessage;
private bool isSaving = false;
    private readonly Guid businessId = Guid.Parse("11111111-1111-1111-1111-111111111111");

private async Task HandleSave()
{
    if (isSaving)
    {
        return;
    }

    errorMessage = null;

    if (string.IsNullOrWhiteSpace(newSupplier.Name))
    {
        errorMessage = "Supplier name is required.";
        return;
    }

    isSaving = true;

    var request = new CreateSupplierRequest
    {
        BusinessId = businessId,
        Name = newSupplier.Name.Trim(),
        ContactPerson = string.IsNullOrWhiteSpace(newSupplier.ContactPerson)
            ? null
            : newSupplier.ContactPerson.Trim(),
        Email = string.IsNullOrWhiteSpace(newSupplier.Email)
            ? null
            : newSupplier.Email.Trim(),
        Phone = string.IsNullOrWhiteSpace(newSupplier.Phone)
            ? null
            : newSupplier.Phone.Trim(),
        Address = string.IsNullOrWhiteSpace(newSupplier.Address)
            ? null
            : newSupplier.Address.Trim(),
        IsActive = true
    };

    try
    {
        await SupplierApiService.CreateSupplierAsync(request);
        Navigation.NavigateTo("/suppliers");
    }
    catch (Exception ex)
    {
        errorMessage = $"Failed to save supplier: {ex.Message}";
        isSaving = false;
    }
}
    private class SupplierFormModel
    {
        public string Name { get; set; } = string.Empty;
        public string ContactPerson { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Phone { get; set; } = string.Empty;
        public string Address { get; set; } = string.Empty;
    }
}