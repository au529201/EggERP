@page "/suppliers/edit/{Id:guid}"
@attribute [Authorize(Roles = "Admin,Manager")]
@using EggERP.Shared.Models
@using EggERP.Shared.Services
@inject ISupplierApiService SupplierApiService
@inject NavigationManager Navigation

<h3>Edit Supplier</h3>

@if (isLoading)
{
    <p>Loading...</p>
}
else if (notFound)
{
    <p>Supplier not found.</p>
}
else
{
    <EditForm Model="@editModel" OnValidSubmit="HandleSave">
        <div class="mb-3">
            <label>Name</label>
            <InputText class="form-control" @bind-Value="editModel.Name" />
        </div>
        <div class="mb-3">
            <label>Contact Person</label>
            <InputText class="form-control" @bind-Value="editModel.ContactPerson" />
        </div>
        <div class="mb-3">
            <label>Email</label>
            <InputText class="form-control" @bind-Value="editModel.Email" />
        </div>
        <div class="mb-3">
            <label>Phone</label>
            <InputText class="form-control" @bind-Value="editModel.Phone" />
        </div>
        <div class="mb-3">
            <label>Address</label>
            <InputText class="form-control" @bind-Value="editModel.Address" />
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <p style="color:red">@errorMessage</p>
        }
<button type="submit"
        class="btn btn-primary"
        disabled="@isSaving">
    @(isSaving ? "Saving..." : "Save")
</button>
    </EditForm>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private SupplierFormModel editModel = new();
private bool isLoading = true;
private bool notFound = false;
private bool isSaving = false;
private string? errorMessage;
    private readonly Guid businessId = Guid.Parse("11111111-1111-1111-1111-111111111111");

    protected override async Task OnInitializedAsync()
    {
        var supplier = await SupplierApiService.GetSupplierByIdAsync(businessId, Id);

        if (supplier is null)
        {
            notFound = true;
            isLoading = false;
            return;
        }

        editModel = new SupplierFormModel
        {
            Name = supplier.Name,
            ContactPerson = supplier.ContactPerson ?? string.Empty,
            Email = supplier.Email ?? string.Empty,
            Phone = supplier.Phone ?? string.Empty,
            Address = supplier.Address ?? string.Empty
        };

        isLoading = false;
    }

private async Task HandleSave()
{
    if (isSaving)
    {
        return;
    }

    errorMessage = null;

    if (string.IsNullOrWhiteSpace(editModel.Name))
    {
        errorMessage = "Supplier name is required.";
        return;
    }

    isSaving = true;

    var request = new UpdateSupplierRequest
    {
        Id = Id,
        BusinessId = businessId,
        Name = editModel.Name.Trim(),
        ContactPerson = string.IsNullOrWhiteSpace(editModel.ContactPerson)
            ? null
            : editModel.ContactPerson.Trim(),
        Email = string.IsNullOrWhiteSpace(editModel.Email)
            ? null
            : editModel.Email.Trim(),
        Phone = string.IsNullOrWhiteSpace(editModel.Phone)
            ? null
            : editModel.Phone.Trim(),
        Address = string.IsNullOrWhiteSpace(editModel.Address)
            ? null
            : editModel.Address.Trim(),
        IsActive = true
    };

    try
    {
        await SupplierApiService.UpdateSupplierAsync(request);
        Navigation.NavigateTo("/suppliers");
    }
    catch (Exception ex)
    {
        errorMessage = $"Failed to save supplier: {ex.Message}";
        isSaving = false;
    }
}
    private class SupplierFormModel
    {
        public string Name { get; set; } = string.Empty;
        public string ContactPerson { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Phone { get; set; } = string.Empty;
        public string Address { get; set; } = string.Empty;
    }
}