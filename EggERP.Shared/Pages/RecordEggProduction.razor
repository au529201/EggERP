@page "/flocks/eggs/add"
@using EggERP.Shared.Models
@using EggERP.Shared.Services
@inject IFlockApiService FlockApiService
@inject NavigationManager Navigation

<h3>Record Egg Production</h3>

@if (flocks is null)
{
    <p>Loading...</p>
}
else
{
    var linkedFlocks = flocks.Where(f => f.LinkedProductId.HasValue).ToList();

    @if (linkedFlocks.Count == 0)
    {
        <p>
            No flocks have a linked egg product yet.
            <a href="/flocks/add">Add a flock</a> and link it to a product first.
        </p>
    }
    else
    {
        <EditForm Model="@production" OnValidSubmit="HandleSave">
            <div class="mb-3">
                <label>Flock</label>
                <select class="form-select" @bind="production.FlockId">
                    @foreach (var flock in linkedFlocks)
                    {
                        <option value="@flock.Id">@flock.BirdType — @flock.LinkedProductName</option>
                    }
                </select>
            </div>

            <div class="mb-3">
                <label>Date</label>
                <InputDate class="form-control" @bind-Value="production.ProductionDate" />
            </div>

            <div class="mb-3">
                <label>Quantity Produced</label>
                <InputNumber class="form-control" @bind-Value="production.QuantityProduced" />
            </div>

            <div class="mb-3">
                <label>Notes</label>
                <InputTextArea class="form-control" @bind-Value="production.Notes" />
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <p style="color:red">@errorMessage</p>
            }

            <button type="submit" class="btn btn-primary">Record</button>
        </EditForm>
    }
}

@code {
    private List<FlockDto>? flocks;
    private RecordEggProductionRequest production = new();
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        flocks = await FlockApiService.GetFlocksAsync();
        var linked = flocks.Where(f => f.LinkedProductId.HasValue).ToList();
        if (linked.Count > 0)
        {
            production.FlockId = linked[0].Id;
        }
    }

    private async Task HandleSave()
    {
        errorMessage = null;

        var error = await FlockApiService.RecordEggProductionAsync(production);

        if (error is not null)
        {
            errorMessage = error;
            return;
        }

        Navigation.NavigateTo("/flocks");
    }
}