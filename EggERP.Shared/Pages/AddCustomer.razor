@page "/customers/add"
@attribute [Authorize(Roles = "Admin,Manager,Staff")]
@using EggERP.Shared.Models
@using EggERP.Shared.Services
@inject ICustomerApiService CustomerApiService
@inject NavigationManager Navigation

<h3>Add Customer</h3>

<EditForm Model="@newCustomer" OnValidSubmit="HandleSave">
    <div class="mb-3">
        <label>Name</label>
        <InputText class="form-control" @bind-Value="newCustomer.Name" />
    </div>
    <div class="mb-3">
        <label>Email</label>
        <InputText class="form-control" @bind-Value="newCustomer.Email" />
    </div>
    <div class="mb-3">
        <label>Phone</label>
        <InputText class="form-control" @bind-Value="newCustomer.Phone" />
    </div>
    <div class="mb-3">
        <label>Address</label>
        <InputText class="form-control" @bind-Value="newCustomer.Address" />
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <p style="color:red">@errorMessage</p>
    }
<button type="submit"
        class="btn btn-primary"
        disabled="@isSaving">
    @(isSaving ? "Saving..." : "Save")
</button>
</EditForm>

@code {
private CustomerFormModel newCustomer = new();
private string? errorMessage;
private bool isSaving = false;
    private readonly Guid businessId = Guid.Parse("11111111-1111-1111-1111-111111111111");

private async Task HandleSave()
{
    if (isSaving)
    {
        return;
    }

    errorMessage = null;

    if (string.IsNullOrWhiteSpace(newCustomer.Name))
    {
        errorMessage = "Customer name is required.";
        return;
    }

    isSaving = true;

    var request = new CreateCustomerRequest
    {
        BusinessId = businessId,
        Name = newCustomer.Name.Trim(),
        Email = string.IsNullOrWhiteSpace(newCustomer.Email)
            ? null
            : newCustomer.Email.Trim(),
        Phone = string.IsNullOrWhiteSpace(newCustomer.Phone)
            ? null
            : newCustomer.Phone.Trim(),
        Address = string.IsNullOrWhiteSpace(newCustomer.Address)
            ? null
            : newCustomer.Address.Trim(),
        IsActive = true
    };

    try
    {
        await CustomerApiService.CreateCustomerAsync(request);
        Navigation.NavigateTo("/customers");
    }
    catch (Exception ex)
    {
        errorMessage = $"Failed to save customer: {ex.Message}";
        isSaving = false;
    }
}
    private class CustomerFormModel
    {
        public string Name { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Phone { get; set; } = string.Empty;
        public string Address { get; set; } = string.Empty;
    }
}