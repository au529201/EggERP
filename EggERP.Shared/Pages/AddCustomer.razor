@page "/customers/add"
@attribute [Authorize(Roles = "Admin,Manager,Staff")]

@using EggERP.Shared.Models
@using EggERP.Shared.Services

@inject ICustomerApiService CustomerApiService
@inject CurrentBusinessService CurrentBusinessService
@inject NavigationManager Navigation

<h3>Add Customer</h3>

<EditForm Model="@newCustomer" OnValidSubmit="HandleSave">
    <div class="mb-3">
        <label class="form-label">Name</label>
        <InputText class="form-control"
                   @bind-Value="newCustomer.Name" />
    </div>

    <div class="mb-3">
        <label class="form-label">Email</label>
        <InputText class="form-control"
                   @bind-Value="newCustomer.Email" />
    </div>

    <div class="mb-3">
        <label class="form-label">Phone</label>
        <InputText class="form-control"
                   @bind-Value="newCustomer.Phone" />
    </div>

    <div class="mb-3">
        <label class="form-label">Address</label>
        <InputText class="form-control"
                   @bind-Value="newCustomer.Address" />
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">
            @errorMessage
        </div>
    }

    <div class="d-flex gap-2">
        <button type="submit"
                class="btn btn-primary"
                disabled="@isSaving">
            @(isSaving ? "Saving..." : "Save")
        </button>

        <button type="button"
                class="btn btn-secondary"
                disabled="@isSaving"
                @onclick="Cancel">
            Cancel
        </button>
    </div>
</EditForm>

@code {
    private CustomerFormModel newCustomer = new();
    private string? errorMessage;
    private bool isSaving;

    private async Task HandleSave()
    {
        if (isSaving)
            return;

        errorMessage = null;

        if (string.IsNullOrWhiteSpace(newCustomer.Name))
        {
            errorMessage = "Customer name is required.";
            return;
        }

        isSaving = true;

        try
        {
            var businessId =
                await CurrentBusinessService.GetBusinessIdAsync();

            if (businessId == Guid.Empty)
            {
                errorMessage = "Unable to identify the current business.";
                return;
            }

            var request = new CreateCustomerRequest
            {
                BusinessId = businessId,
                Name = newCustomer.Name.Trim(),
                Email = string.IsNullOrWhiteSpace(newCustomer.Email)
                    ? null
                    : newCustomer.Email.Trim(),
                Phone = string.IsNullOrWhiteSpace(newCustomer.Phone)
                    ? null
                    : newCustomer.Phone.Trim(),
                Address = string.IsNullOrWhiteSpace(newCustomer.Address)
                    ? null
                    : newCustomer.Address.Trim(),
                IsActive = true
            };

            await CustomerApiService.CreateCustomerAsync(request);

            Navigation.NavigateTo("/customers");
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to save customer: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/customers");
    }

    private class CustomerFormModel
    {
        public string Name { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Phone { get; set; } = string.Empty;
        public string Address { get; set; } = string.Empty;
    }
}
