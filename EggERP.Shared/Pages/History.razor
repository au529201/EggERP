
@page "/history"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(
    Roles = "Admin,Manager,Staff")]

@using EggERP.Shared.Models
@using EggERP.Shared.Services
@using EggERP.Shared.Components
@using System.Threading

@implements IDisposable
@inject IActivityLogApiService ActivityLogApiService

<PageTitle>Activity History - EzEggERP</PageTitle>

<div class="mb-4">
    <h3 class="mb-1">Activity History</h3>
    <p class="text-muted mb-0">
        View recorded business activities and transaction history.
    </p>
</div>

<div class="card mb-4">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-12 col-md-6 col-xl-4">
                <label class="form-label">Search</label>
                <input class="form-control"
                       placeholder="User, action, details..."
                       value="@searchText"
                       @oninput="OnSearchInput" />
            </div>

            <div class="col-12 col-md-6 col-xl-3">
                <label class="form-label">Entity Type</label>
                <select class="form-select"
                        @bind="entityType"
                        @bind:after="FiltersChangedAsync">
                    <option value="">All Types</option>
                    @foreach (var type in entityTypes)
                    {
                        <option value="@type">@type</option>
                    }
                </select>
            </div>

            <div class="col-6 col-md-4 col-xl-2">
                <label class="form-label">From (UTC)</label>
                <input type="date" class="form-control"
                       @bind="startDate"
                       @bind:after="FiltersChangedAsync" />
            </div>

            <div class="col-6 col-md-4 col-xl-2">
                <label class="form-label">To (UTC)</label>
                <input type="date" class="form-control"
                       @bind="endDate"
                       @bind:after="FiltersChangedAsync" />
            </div>

            <div class="col-12 col-md-4 col-xl-1 d-grid">
                <button type="button"
                        class="btn btn-outline-secondary"
                        @onclick="ClearFiltersAsync">
                    Clear
                </button>
            </div>
        </div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-warning" role="alert">
        @error
    </div>
}

<div class="card">
    <div class="card-body">
        <div class="d-flex justify-content-between
                    align-items-center gap-2 mb-3">
            <h5 class="mb-0">Business Activities</h5>
            @if (loading)
            {
                <span class="small text-muted">Loading...</span>
            }
        </div>

        <div class="table-responsive"
             role="region"
             aria-label="Activity history"
             tabindex="0">
            <table class="table table-striped table-hover
              align-middle mb-0 erp-history-table">
                <thead>
                    <tr>
                        <th>Timestamp</th>
                        <th>User</th>
                        <th>Action</th>
                        <th>Type</th>
                        <th>Reference</th>
                        <th>Details</th>
                    </tr>
                </thead>
                <tbody>
                    @if (loading && logs.Count == 0)
                    {
                        <tr>
                            <td colspan="6"
                                class="text-center py-4">
                                Loading activity history...
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var log in logs)
                        {
                            <tr @key="log.Id">
                                <td class="text-nowrap">
@(log.TimestampUtc.ToLocalTime().ToString("g"))
                                </td>
                                <td>@log.UserName</td>
                                <td>@log.Action</td>
                                <td>@log.EntityType</td>
                                <td>
                                    @if (log.EntityId.HasValue)
                                    {
                                    <code class="text-nowrap"
                                          title="@log.EntityId.Value.ToString()">
                                        @(log.EntityId.Value.ToString("N")[..8])
                                    </code>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    @(string.IsNullOrWhiteSpace(log.Details)
                                        ? "—" : log.Details)
                                </td>
                            </tr>
                        }

                        @if (logs.Count == 0)
                        {
                            <tr>
                                <td colspan="6"
                                    class="text-center py-4">
                                    No activity found.
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
<EzPagination TotalCount="totalCount"
              Page="@(page)"
              PageSize="PageSize"
              Disabled="loading"
              PageChanged="@GoToPageAsync" />
    </div>
</div>

@code {
    private static readonly string[] entityTypes =
    {
        "Product", "Customer", "Supplier", "Inventory",
        "Sale", "Purchase", "Expense", "User",
        "Business", "Flock", "Egg"
    };

    private List<ActivityLogDto> logs = new();

    private string searchText = "";
    private string entityType = "";
    private DateTime? startDate;
    private DateTime? endDate;

    private int page = 1;
    private const int PageSize = 10;
    private int totalCount;
    private bool loading = true;
    private string? error;

    private CancellationTokenSource? debounce;
    private long requestVersion;
    private bool disposed;

    protected override async Task OnInitializedAsync()
    {
        await LoadLogsAsync();
    }

    private async Task OnSearchInput(ChangeEventArgs args)
    {
        searchText = args.Value?.ToString() ?? "";
        debounce?.Cancel();
        debounce?.Dispose();

        var source = new CancellationTokenSource();
        debounce = source;

        try
        {
            await Task.Delay(300, source.Token);

            if (!source.IsCancellationRequested && !disposed)
                await FiltersChangedAsync();
        }
        catch (OperationCanceledException)
        {
            // A newer search has replaced this one.
        }
    }

    private async Task FiltersChangedAsync()
    {
        page = 1;
        await LoadLogsAsync();
    }

    private async Task ClearFiltersAsync()
    {
        debounce?.Cancel();

        searchText = "";
        entityType = "";
        startDate = null;
        endDate = null;
        page = 1;

        await LoadLogsAsync();
    }

    private async Task GoToPageAsync(int target)
    {
        if (loading || target < 1)
            return;

        page = target;
        await LoadLogsAsync();
    }

    private async Task LoadLogsAsync()
    {
        var version = ++requestVersion;

        if (startDate.HasValue && endDate.HasValue &&
            startDate.Value.Date > endDate.Value.Date)
        {
            error = "From date cannot be after To date.";
            logs.Clear();
            totalCount = 0;
            loading = false;
            return;
        }

        loading = true;
        error = null;

        var requestedPage = page;

        try
        {
            var result = await ActivityLogApiService.SearchPagedAsync(
                searchText, entityType, startDate, endDate,
                requestedPage, PageSize);

            if (disposed || version != requestVersion)
                return;

            var totalPages = Math.Max(1,
                (int)Math.Ceiling(
                    result.TotalCount / (double)PageSize));

            if (requestedPage > totalPages)
            {
                page = totalPages;
                await LoadLogsAsync();
                return;
            }

            logs = result.Items ?? new();
            totalCount = result.TotalCount;
        }
        catch (Exception)
        {
            if (disposed || version != requestVersion)
                return;

            error = "Unable to load activity history.";
            logs = new();
            totalCount = 0;
        }
        finally
        {
            if (!disposed && version == requestVersion)
                loading = false;
        }
    }

    public void Dispose()
    {
        disposed = true;
        debounce?.Cancel();
        debounce?.Dispose();
    }
}
