
@page "/platform/businesses"
@attribute [Authorize(Roles = "PlatformAdmin")]
@rendermode InteractiveServer

@using EggERP.Shared.Services
@using EggERP.Shared.Components
@inject IPlatformBusinessApiService PlatformApi

<PageTitle>Platform Administration - EzEggERP</PageTitle>

<div class="container-fluid py-3">

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Platform Administration</h2>
            <p class="text-muted mb-0">
                Manage EzEggERP businesses, owner invitations,
                and business access.
            </p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert @(isError ? "alert-danger" : "alert-success")"
             role="alert">
            @message
        </div>
    }

    <div class="card mb-4">
        <div class="card-header">
            <strong>Invite New Business Owner</strong>
        </div>

        <div class="card-body">
            <EditForm Model="@form" OnValidSubmit="InviteOwner">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="row g-3">

                    <div class="col-md-6">
                        <label class="form-label">Business Name *</label>
                        <InputText class="form-control"
                                   @bind-Value="form.BusinessName" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Owner Full Name *</label>
                        <InputText class="form-control"
                                   @bind-Value="form.OwnerFullName" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Owner Email *</label>
                        <InputText class="form-control"
                                   type="email"
                                   @bind-Value="form.OwnerEmail" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Business Email</label>
                        <InputText class="form-control"
                                   type="email"
                                   @bind-Value="form.BusinessEmail" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Phone</label>
                        <InputText class="form-control"
                                   @bind-Value="form.Phone" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">City</label>
                        <InputText class="form-control"
                                   @bind-Value="form.City" />
                    </div>

                    <div class="col-12">
                        <button type="submit"
                                class="btn btn-primary"
                                disabled="@submitting">
                            @(submitting
                                ? "Sending Invitation..."
                                : "Create Business & Send Invitation")
                        </button>
                    </div>

                </div>
            </EditForm>
        </div>
    </div>

    <div class="card">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <strong>Registered Businesses</strong>

            <button type="button"
                    class="btn btn-sm btn-outline-secondary"
                    disabled="@loading"
                    @onclick="RefreshBusinesses">
                <i class="bi bi-arrow-clockwise"></i>
                Refresh
            </button>
        </div>

        <div class="card-body">
            <div class="row g-2 mb-3">
                <div class="col-md-6">
                    <label class="form-label">Search Businesses</label>
                    <input class="form-control"
                           placeholder="Search business, owner or email..."
                           @bind="searchText"
                           @bind:event="oninput"
                           @bind:after="ResetPage" />
                </div>

                <div class="col-md-3">
                    <label class="form-label">Business Status</label>
                    <select class="form-select"
                            @bind="statusFilter"
                            @bind:after="ResetPage">
                        <option value="All">All</option>
                        <option value="Active">Active</option>
                        <option value="Suspended">Suspended</option>
                    </select>
                </div>

                <div class="col-md-3 d-flex align-items-end">
                    <button type="button"
                            class="btn btn-outline-secondary w-100"
                            @onclick="ClearFilters">
                        Clear
                    </button>
                </div>
            </div>

            @if (loading)
            {
                <p>Loading businesses...</p>
            }
else if (!FilteredBusinesses.Any())
            {
                <p class="text-muted mb-0">
                    No businesses found.
                </p>
            }
            else
            {
<div class="erp-table-scroll"
     role="region"
     aria-label="Registered businesses table"
     tabindex="0">
    <table class="table erp-data-table table-striped table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Business</th>
                                <th>Owner</th>
                                <th>Email</th>
                                <th>Invitation Status</th>
                                <th>Business Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>
@foreach (var business in PagedBusinesses)
                            {
                                <tr>
                                    <td>@business.BusinessName</td>

                                    <td>@business.OwnerName</td>

                                    <td>@business.OwnerEmail</td>

                                    <td>
                                        @if (business.OwnerEmailConfirmed)
                                        {
                                            <span class="badge bg-success">
                                                Activated
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Pending Invitation
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @if (business.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Suspended
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @if (pendingBusinessId == business.BusinessId)
                                        {
                                            <div class="d-flex flex-wrap gap-2 align-items-center">
                                                <span class="small">
                                                    @(business.IsActive
                                                        ? "Suspend this business?"
                                                        : "Reactivate this business?")
                                                </span>

                                                <button type="button"
                                                        class="btn btn-sm @(business.IsActive ? "btn-danger" : "btn-success")"
                                                        disabled="@updatingStatus"
                                                        @onclick="() => ConfirmStatusChange(business)">
                                                    @(updatingStatus ? "Saving..." : "Confirm")
                                                </button>

                                                <button type="button"
                                                        class="btn btn-sm btn-outline-secondary"
                                                        disabled="@updatingStatus"
                                                        @onclick="CancelStatusChange">
                                                    Cancel
                                                </button>
                                            </div>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="btn btn-sm @(business.IsActive ? "btn-outline-danger" : "btn-outline-success")"
                                                    disabled="@updatingStatus"
                                                    @onclick="() => RequestStatusChange(business)">
                                                @(business.IsActive ? "Suspend" : "Reactivate")
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <EzPagination TotalCount="FilteredBusinesses.Count()"
                              Page="page"
                              PageSize="PageSize"
                              Disabled="updatingStatus"
                              PageChanged="OnPageChanged" />
            }
        </div>
    </div>
</div>

@code {
private CreatePlatformBusinessRequest form = new();
private List<PlatformBusinessDto> businesses = new();

private string searchText = string.Empty;
private string statusFilter = "All";

private int page = 1;
private const int PageSize = 10;

private IEnumerable<PlatformBusinessDto> FilteredBusinesses =>
    businesses.Where(b =>
        (
            string.IsNullOrWhiteSpace(searchText) ||
            (b.BusinessName ?? string.Empty).Contains(
                searchText, StringComparison.OrdinalIgnoreCase) ||
            (b.OwnerName ?? string.Empty).Contains(
                searchText, StringComparison.OrdinalIgnoreCase) ||
            (b.OwnerEmail ?? string.Empty).Contains(
                searchText, StringComparison.OrdinalIgnoreCase)
        )
        &&
        (
            statusFilter == "All" ||
            (statusFilter == "Active" && b.IsActive) ||
            (statusFilter == "Suspended" && !b.IsActive)
        ));

private IEnumerable<PlatformBusinessDto> PagedBusinesses =>
    FilteredBusinesses
        .Skip((page - 1) * PageSize)
        .Take(PageSize);

private void ResetPage() => page = 1;

private void OnPageChanged(int newPage)
{
    page = newPage;
}

private void ClearFilters()
{
    searchText = string.Empty;
    statusFilter = "All";
    page = 1;
}

    private bool loading = true;
    private bool submitting;
    private bool updatingStatus;
    private bool isError;

    private Guid? pendingBusinessId;
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        await LoadBusinesses();
    }

    private async Task LoadBusinesses()
    {
        loading = true;

        try
        {
businesses = await PlatformApi.GetBusinessesAsync();

var totalPages = Math.Max(
    1,
    (int)Math.Ceiling(FilteredBusinesses.Count() / (double)PageSize));

page = Math.Clamp(page, 1, totalPages);        }
            catch (Exception ex)
            {
                businesses = new();
                isError = true;
                message = ex.Message;
            }
        finally
        {
            loading = false;
        }
    }

    private async Task RefreshBusinesses()
    {
        message = null;
        pendingBusinessId = null;

        await LoadBusinesses();
    }

    private async Task InviteOwner()
    {
        if (submitting || updatingStatus)
            return;

        submitting = true;
        message = null;

        try
        {
            var error = await PlatformApi.CreateBusinessAsync(form);

            if (error is null)
            {
                isError = false;
                message = "Business created and invitation sent.";

                form = new CreatePlatformBusinessRequest();

                await LoadBusinesses();
            }
            else
            {
                isError = true;
                message = error;
            }
        }
        catch
        {
            isError = true;
            message = "Unable to complete the invitation request.";
        }
        finally
        {
            submitting = false;
        }
    }

    private void RequestStatusChange(PlatformBusinessDto business)
    {
        if (updatingStatus)
            return;

        pendingBusinessId = business.BusinessId;
        message = null;
    }

    private void CancelStatusChange()
    {
        if (updatingStatus)
            return;

        pendingBusinessId = null;
    }

    private async Task ConfirmStatusChange(
        PlatformBusinessDto business)
    {
        if (updatingStatus ||
            pendingBusinessId != business.BusinessId)
        {
            return;
        }

        updatingStatus = true;
        message = null;

        try
        {
            bool targetStatus = !business.IsActive;

            var error = await PlatformApi.ChangeBusinessStatusAsync(
                business.BusinessId,
                targetStatus);

            if (error is not null)
            {
                isError = true;
                message = error;
                return;
            }

            isError = false;

            message = targetStatus
                ? $"Business '{business.BusinessName}' reactivated successfully."
                : $"Business '{business.BusinessName}' suspended successfully.";

            pendingBusinessId = null;

            await LoadBusinesses();
        }
        catch
        {
            isError = true;
            message = "Unable to change business status.";
        }
        finally
        {
            updatingStatus = false;
        }
    }
}
