@page "/flocks/eggs/add"
@using EggERP.Shared.Models
@using EggERP.Shared.Services
@inject IFlockApiService FlockApiService
@inject IProductApiService ProductApiService
@inject NavigationManager Navigation

<h3>Record Egg Movement</h3>

@if (products is null || flocks is null)
{
    <p>Loading...</p>
}
else
{
    <EditForm Model="@movement" OnValidSubmit="HandleSave">
        <div class="mb-3">
            <label>Direction</label>
            <select class="form-select" @bind="movement.Direction">
                <option value="In">In</option>
                <option value="Out">Out</option>
            </select>
        </div>

        <div class="mb-3">
            <label>Reason</label>
            <select class="form-select" @bind="movement.Reason">
                @foreach (var reason in CurrentReasons)
                {
                    <option value="@reason">@reason</option>
                }
            </select>
            @if (movement.Direction == "Out" && movement.Reason != "Hatched")
            {
                <small class="form-text text-muted">"Sold" is not available here — sales are recorded through the Sales page.</small>
            }
        </div>

        <div class="mb-3">
            <label>Product</label>
            <select class="form-select" @bind="selectedProductId">
                @foreach (var product in products)
                {
                    <option value="@product.Id">@product.Name</option>
                }
            </select>
        </div>

        <div class="mb-3">
            <label>Flock @(movement.Reason == "Hatched" ? "(required)" : "(optional)")</label>
            <select class="form-select" @bind="selectedFlockId">
                <option value="">-- None --</option>
                @foreach (var flock in flocks)
                {
                    <option value="@flock.Id">@flock.Name</option>
                }
            </select>
        </div>

        <div class="mb-3">
            <label>Quantity</label>
            <InputNumber class="form-control" @bind-Value="movement.Quantity" />
        </div>

        <div class="mb-3">
            <label>Date</label>
            <InputDate class="form-control" @bind-Value="movement.MovementDate" />
        </div>

        <div class="mb-3">
            <label>Notes</label>
            <InputTextArea class="form-control" @bind-Value="movement.Notes" />
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <p style="color:red">@errorMessage</p>
        }

        <button type="submit" class="btn btn-primary">Record</button>
    </EditForm>
}

@code {
    private readonly string[] inReasons = { "Laid", "Bought" };
    private readonly string[] outReasons = { "Broken", "Stolen", "Missing", "Hatched" };

    private string[] CurrentReasons => movement.Direction == "In" ? inReasons : outReasons;

    private List<ProductDto>? products;
    private List<FlockDto>? flocks;
    private RecordEggMovementRequest movement = new();
    private string selectedProductId = "";
    private string selectedFlockId = "";
    private string? errorMessage;

    private readonly Guid businessId = Guid.Parse("11111111-1111-1111-1111-111111111111");

    protected override async Task OnInitializedAsync()
    {
        products = await ProductApiService.GetProductsAsync(businessId);
        flocks = await FlockApiService.GetFlocksAsync();

        if (products.Count > 0) selectedProductId = products[0].Id.ToString();
        movement.Reason = CurrentReasons[0];
    }

    private async Task HandleSave()
    {
        errorMessage = null;

        movement.ProductId = Guid.TryParse(selectedProductId, out var pid) ? pid : Guid.Empty;
        movement.FlockId = Guid.TryParse(selectedFlockId, out var fid) ? fid : null;

        var error = await FlockApiService.RecordEggMovementAsync(movement);
        if (error is not null)
        {
            errorMessage = error;
            return;
        }

        Navigation.NavigateTo("/flocks");
    }
}