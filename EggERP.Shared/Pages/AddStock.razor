@page "/stock/add"
@attribute [Authorize(Roles = "Admin,Manager")]
@using EggERP.Shared.Models
@using EggERP.Shared.Services
@inject IStockApiService StockApiService
@inject IProductApiService ProductApiService
@inject ISupplierApiService SupplierApiService
@inject IFlockApiService FlockApiService
@inject IEggApiService EggApiService
@inject IJSRuntime JsRuntime
@inject NavigationManager Navigation

<h3>Add Stock</h3>

@if (products is null)
{
    <p>Loading...</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Group</th>
                <th>Type</th>
                <th>Quantity</th>
                <th>Reason</th>
                <th>Supplier</th>
                <th>Cost</th>
                <th>Pay</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var line in lines)
            {
                <tr>
                    <td>
                        <select class="form-select" @bind="line.Group" @bind:after="() => OnGroupChanged(line)">
                            <option value="Flock">Flock</option>
                            <option value="Egg">Egg</option>
                        </select>
                    </td>
                    <td>
                        <select class="form-select" @bind="line.ProductId" @bind:after="() => OnProductChanged(line)">
                            <option value="">Select product</option>
                            @foreach (var product in AvailableProducts(line))
                            {
                                <option value="@product.Id">@product.Type - @product.Description</option>
                            }
                        </select>
                        @if (Guid.TryParse(line.ProductId, out var pid) && stockOnHand.TryGetValue(pid, out var qty))
                        {
                            <div class="stock-hint">@qty in stock</div>
                        }
                    </td>
                    <td>
                        <input type="number" step="1" min="1" class="form-control" @bind="line.Quantity" />
                    </td>
                    <td>
                        <select class="form-select" @bind="line.Reason">
                            <option value="Bought">Bought</option>
                            @foreach (var r in InReasons(line.Group))
                            {
                                <option value="@r">@r</option>
                            }
                        </select>
                    </td>
                    <td>
                        @if (line.Reason == "Bought")
                        {
                            <select class="form-select" @bind="line.SupplierId">
                                <option value="">Unspecified</option>
                                @foreach (var s in suppliers ?? new())
                                {
                                    <option value="@s.Id">@s.Name</option>
                                }
                            </select>
                        }
                    </td>
                    <td>
                        @if (line.Reason == "Bought")
                        {
                            <input type="number" step="0.01" class="form-control" @bind="line.UnitCost" />
                        }
                    </td>
                    <td>
                        @if (line.Reason == "Bought")
                        {
                            @((line.Quantity * line.UnitCost).ToString("N2"))
                        }
                    </td>
                    <td>
                        <button class="btn btn-sm btn-danger" @onclick="() => RemoveLine(line)">Remove</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <button class="btn btn-secondary mb-3" @onclick="AddLine" disabled="@(!CanAddLine())">+ Add Line</button>

    @if (HasPaymentLine)
    {
        <h5>Total Amount: @(TotalCost.ToString("N2"))</h5>

        <div class="txn-row">
            <div>
                <label>Status</label>
<select class="form-select" @bind="status">
    <option value="Paid">Paid</option>
    <option value="Pending">Pending</option>
</select>
            </div>
            <div>
                <label>Payment Method</label>
                <select class="form-select" @bind="paymentMethod">
                    <option value="Cash">Cash</option>
                    <option value="Credit Card">Credit Card</option>
                    <option value="Debit Card">Debit Card</option>
                    <option value="Other">Other</option>
                </select>
            </div>
            <div>
                <label>Bank Name</label>
                <input class="form-control" @bind="bankName" placeholder="e.g. BDO, MariBank, GCash" />
            </div>
            <div>
                <label>Reference ID</label>
                <input class="form-control" @bind="referenceNumber" />
            </div>
        </div>
    }

    <div class="mb-3" style="max-width:400px;">
        <label>Date</label>
        <input type="date" class="form-control" @bind="movementDate" />
    </div>
    <div class="mb-3" style="max-width:600px;">
        <label>Notes</label>
        <textarea class="form-control" @bind="notes"></textarea>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <p style="color:red">@errorMessage</p>
    }

    <div class="txn-actions">
<button class="btn btn-outline-secondary"
        @onclick="Cancel"
        disabled="@isSaving">
    Cancel
</button><button class="btn btn-primary"
        @onclick="HandleSave"
        disabled="@isSaving">
    @(isSaving ? "Processing..." : "Complete Transaction")
</button>    </div>
}

@code {
    private class Line
    {
        public string Group { get; set; } = "Flock";
        public string ProductId { get; set; } = string.Empty;
        public int Quantity { get; set; } = 1;
        public string Reason { get; set; } = "Moved";
        public decimal UnitCost { get; set; }
        public string SupplierId { get; set; } = string.Empty;
    }

    private readonly string[] flockInReasons = { "Moved", "Hatched" };
    private readonly string[] eggInReasons = { "Laid", "Moved" };

    private List<ProductDto>? products;
    private List<SupplierDto>? suppliers;
    private List<Line> lines = new();
    private Dictionary<Guid, int> stockOnHand = new();

    private string status = "Paid";
    private string paymentMethod = "Cash";
    private string? bankName;
    private string? referenceNumber;
    private DateTime movementDate = DateTime.Today;
    private string? notes;
    private string? errorMessage;
    private bool isSaving;
    private readonly Guid businessId = Guid.Parse("11111111-1111-1111-1111-111111111111");

    private bool HasPaymentLine => lines.Any(l => l.Reason == "Bought");
    private decimal TotalCost => lines.Where(l => l.Reason == "Bought").Sum(l => l.Quantity * l.UnitCost);

    protected override async Task OnInitializedAsync()
    {
       products = await ProductApiService.GetProductsAsync();
       suppliers = await SupplierApiService.GetSuppliersAsync(businessId);

        var flockBoard = await FlockApiService.GetBoardAsync();
        var eggBoard = await EggApiService.GetBoardAsync();
        foreach (var row in flockBoard.Concat(eggBoard))
        {
            stockOnHand[row.ProductId] = row.Available;
        }

        lines.Add(new Line());
    }

    private string[] InReasons(string group) => group == "Flock" ? flockInReasons : eggInReasons;

    private IEnumerable<ProductDto> AvailableProducts(Line current)
    {
        var takenIds = lines.Where(l => l != current && !string.IsNullOrEmpty(l.ProductId))
                             .Select(l => l.ProductId).ToHashSet();
        return (products ?? new()).Where(p => p.Group == current.Group && !takenIds.Contains(p.Id.ToString()));
    }

    private bool CanAddLine() => lines.Count < (products?.Count ?? 0);

    private void OnGroupChanged(Line line)
    {
        line.ProductId = string.Empty;
        line.Reason = InReasons(line.Group)[0];
    }

    private void OnProductChanged(Line line)
    {
        if (Guid.TryParse(line.ProductId, out var pid))
        {
            var product = products?.FirstOrDefault(p => p.Id == pid);
            if (product is not null) line.UnitCost = product.CostPrice;
        }
    }

    private void AddLine() => lines.Add(new Line { Reason = InReasons("Flock")[0] });
    private void RemoveLine(Line line) => lines.Remove(line);

    private async Task Cancel()
    {
        var confirmed = await JsRuntime.InvokeAsync<bool>("confirm", "Discard this entry and go back? Unsaved changes will be lost.");
        if (confirmed)
        {
            Navigation.NavigateTo("/flocks");
        }
    }

private async Task HandleSave()
{
    if (isSaving)
        return;

    errorMessage = null;

    var validLines = lines
        .Where(l => !string.IsNullOrEmpty(l.ProductId) && l.Quantity > 0)
        .ToList();

    if (validLines.Count == 0)
    {
        errorMessage = "Add at least one valid line item.";
        return;
    }

    if (HasPaymentLine &&
        paymentMethod != "Cash" &&
        (string.IsNullOrWhiteSpace(bankName) ||
         string.IsNullOrWhiteSpace(referenceNumber)))
    {
        errorMessage =
            "Bank Name and Reference ID are required for non-cash payments.";
        return;
    }

    isSaving = true;

    try
    {
        var request = new ProcessStockTransactionRequest
        {
            BusinessId = businessId,
            Direction = "In",
            MovementDate = movementDate,
            Notes = notes,
            Status = status,
            PaymentMethod = paymentMethod,
            PaymentSource = paymentMethod == "Cash"
                ? null
                : paymentMethod,
            ReferenceNumber = paymentMethod == "Cash"
                ? null
                : referenceNumber,
            BankName = paymentMethod == "Cash"
                ? null
                : bankName,

            Lines = validLines.Select(l =>
                new StockTransactionLineRequest
                {
                    Group = l.Group,
                    ProductId = Guid.Parse(l.ProductId),
                    Reason = l.Reason,
                    Quantity = l.Quantity,
                    UnitCost = l.UnitCost,
                    SupplierId =
                        Guid.TryParse(l.SupplierId, out var sid)
                            ? sid
                            : null
                }).ToList()
        };

        var error = await StockApiService.ProcessAsync(request);

        if (error is not null)
        {
            errorMessage = error;
            return;
        }

        Navigation.NavigateTo("/flocks");
    }
    catch (Exception ex)
    {
        errorMessage =
            $"Failed to complete transaction: {ex.Message}";
    }
    finally
    {
        isSaving = false;
    }
}
}