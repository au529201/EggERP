@page "/stock/add"
@attribute [Authorize(Roles = "Admin,Manager")]
@using EggERP.Shared.Models
@using EggERP.Shared.Services
@inject IStockApiService StockApiService
@inject IProductApiService ProductApiService
@inject ISupplierApiService SupplierApiService
@inject IFlockApiService FlockApiService
@inject IEggApiService EggApiService
@inject IJSRuntime JsRuntime
@inject NavigationManager Navigation

<h3>Add Stock</h3>

@if (products is null)
{
    <p>Loading...</p>
}
else
{
    <div class="table-responsive">
        <table class="table txn-table">
            <thead>
                <tr>
                    <th style="width:100px;">Group</th>
                    <th>Type / Product</th>
                    <th class="txn-col-qty">Qty</th>
                    <th style="width:125px;">Reason</th>
                    <th style="min-width:180px;">Supplier</th>
                    <th class="txn-col-money">Cost</th>
                    <th class="txn-col-total">Pay</th>
                    <th class="txn-col-action"></th>
                </tr>
            </thead>

            <tbody>
                @foreach (var line in lines)
                {
                    <tr>
                        <td>
                            <select class="form-select"
                                    @bind="line.Group"
                                    @bind:after="() => OnGroupChanged(line)"
                                    disabled="@isSaving">
                                <option value="Flock">Flock</option>
                                <option value="Egg">Egg</option>
                            </select>
                        </td>

                        <td>
                            <select class="form-select"
                                    @bind="line.ProductId"
                                    @bind:after="() => OnProductChanged(line)"
                                    disabled="@isSaving">
                                <option value="">Select product</option>

                                @foreach (var product in AvailableProducts(line))
                                {
                                    <option value="@product.Id">
                                        @product.Type - @product.Description
                                    </option>
                                }
                            </select>

                            @if (Guid.TryParse(line.ProductId, out var pid) &&
                                 stockOnHand.TryGetValue(pid, out var qty))
                            {
                                <div class="stock-hint">
                                    @qty in stock
                                </div>
                            }
                        </td>

                        <td class="txn-col-qty">
                            <input type="number"
                                   step="1"
                                   min="1"
                                   max="9999"
                                   class="form-control"
                                   @bind="line.Quantity"
                                   disabled="@isSaving" />
                        </td>

                        <td>
                            <select class="form-select"
                                    @bind="line.Reason"
                                    disabled="@isSaving">
                                <option value="Bought">Bought</option>

                                @foreach (var reason in InReasons(line.Group))
                                {
                                    <option value="@reason">
                                        @reason
                                    </option>
                                }
                            </select>
                        </td>

                        <td>
                            @if (line.Reason == "Bought")
                            {
                                <select class="form-select"
                                        @bind="line.SupplierId"
                                        disabled="@isSaving">
                                    <option value="">
                                        Unspecified / Traveler
                                    </option>

                                    @foreach (var supplier in suppliers ?? new())
                                    {
                                        <option value="@supplier.Id">
                                            @supplier.Name
                                        </option>
                                    }
                                </select>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>

                        <td class="txn-col-money">
                            @if (line.Reason == "Bought")
                            {
                                <input type="number"
                                       step="0.01"
                                       min="0"
                                       class="form-control"
                                       @bind="line.UnitCost"
                                       disabled="@isSaving" />
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>

                        <td class="txn-col-total">
                            @if (line.Reason == "Bought")
                            {
                                @((line.Quantity * line.UnitCost).ToString("N2"))
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>

                        <td class="txn-col-action">
                            <button type="button"
                                    class="btn btn-sm btn-danger"
                                    @onclick="() => RemoveLine(line)"
                                    disabled="@isSaving">
                                Remove
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <button type="button"
            class="btn btn-secondary"
            @onclick="AddLine"
            disabled="@(isSaving || !CanAddLine())">
        + Add Line
    </button>

    @if (HasPaymentLine)
    {
        <h5 class="txn-total">
            Bought Total: @TotalCost.ToString("N2")
        </h5>
    }

    <div class="txn-row">
        @if (HasPaymentLine)
        {
            <div class="txn-field">
                <label>Status</label>

                <select class="form-select"
                        @bind="status"
                        disabled="@isSaving">
                    <option value="Paid">Paid</option>
                    <option value="Pending">Pending</option>
                </select>
            </div>

            <div class="txn-field">
                <label>Payment Method</label>

                <select class="form-select"
                        @bind="paymentMethod"
                        @bind:after="OnPaymentMethodChanged"
                        disabled="@isSaving">
                    <option value="Cash">Cash</option>
                    <option value="Credit Card">Credit Card</option>
                    <option value="Debit Card">Debit Card</option>
                    <option value="Other">Other</option>
                </select>
            </div>

            <div class="txn-field">
                <label>Bank Name / Payment Source</label>

                <input class="form-control"
                       @bind="bankName"
                       placeholder="e.g. BDO, GCash, Maya"
                       disabled="@(isSaving || paymentMethod == "Cash")" />
            </div>

            <div class="txn-field">
                <label>Reference ID</label>

                <input class="form-control"
                       @bind="referenceNumber"
                       placeholder="Required for non-cash"
                       disabled="@(isSaving || paymentMethod == "Cash")" />
            </div>
        }

        <div class="txn-field">
            <label>Date</label>

            <input type="date"
                   class="form-control"
                   @bind="movementDate"
                   disabled="@isSaving" />
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">
            @errorMessage
        </div>
    }

    <div class="txn-bottom-row">
        <div class="txn-notes">
            <label>Notes</label>

            <textarea class="form-control"
                      @bind="notes"
                      placeholder="Optional transaction notes..."
                      disabled="@isSaving"></textarea>
        </div>

        <div class="txn-actions">
            <button type="button"
                    class="btn btn-outline-secondary"
                    @onclick="Cancel"
                    disabled="@isSaving">
                Cancel
            </button>

            <button type="button"
                    class="btn btn-primary"
                    @onclick="HandleSave"
                    disabled="@isSaving">
                @(isSaving ? "Processing..." : "Complete Transaction")
            </button>
        </div>
    </div>
}

@code {
    private class Line
    {
        public string Group { get; set; } = "Flock";
        public string ProductId { get; set; } = string.Empty;
        public int Quantity { get; set; } = 1;
        public string Reason { get; set; } = "Moved";
        public decimal UnitCost { get; set; }
        public string SupplierId { get; set; } = string.Empty;
    }

    private readonly string[] flockInReasons =
    {
        "Moved",
        "Hatched"
    };

    private readonly string[] eggInReasons =
    {
        "Laid",
        "Moved"
    };

    private List<ProductDto>? products;
    private List<SupplierDto>? suppliers;

    private List<Line> lines = new();

    private Dictionary<Guid, int> stockOnHand = new();

    private string status = "Paid";
    private string paymentMethod = "Cash";

    private string? bankName;
    private string? referenceNumber;
    private string? notes;
    private string? errorMessage;

    private DateTime movementDate = DateTime.Today;

    private bool isSaving;

    private readonly Guid businessId =
        Guid.Parse("11111111-1111-1111-1111-111111111111");

    private bool HasPaymentLine =>
        lines.Any(l => l.Reason == "Bought");

    private decimal TotalCost =>
        lines
            .Where(l => l.Reason == "Bought")
            .Sum(l => l.Quantity * l.UnitCost);

    protected override async Task OnInitializedAsync()
    {
        products =
            await ProductApiService.GetProductsAsync();

        suppliers =
            await SupplierApiService
                .GetSuppliersAsync(businessId);

        var flockBoard =
            await FlockApiService.GetBoardAsync();

        var eggBoard =
            await EggApiService.GetBoardAsync();

        foreach (var row in flockBoard.Concat(eggBoard))
        {
            stockOnHand[row.ProductId] =
                row.Available;
        }

        lines.Add(new Line());
    }

    private string[] InReasons(string group)
    {
        return group == "Flock"
            ? flockInReasons
            : eggInReasons;
    }

    private IEnumerable<ProductDto> AvailableProducts(
        Line current)
    {
        var takenIds =
            lines
                .Where(l =>
                    l != current &&
                    !string.IsNullOrWhiteSpace(l.ProductId))
                .Select(l => l.ProductId)
                .ToHashSet();

        return (products ?? new())
            .Where(p =>
                p.Group == current.Group &&
                !takenIds.Contains(p.Id.ToString()));
    }

    private bool CanAddLine()
    {
        return lines.Count <
               (products?.Count ?? 0);
    }

    private void OnGroupChanged(Line line)
    {
        line.ProductId = string.Empty;
        line.Reason = InReasons(line.Group)[0];
        line.SupplierId = string.Empty;
        line.UnitCost = 0;
    }

    private void OnProductChanged(Line line)
    {
        if (!Guid.TryParse(
                line.ProductId,
                out var productId))
        {
            return;
        }

        var product =
            products?.FirstOrDefault(
                p => p.Id == productId);

        if (product is not null)
        {
            line.UnitCost =
                product.CostPrice;
        }
    }

    private void AddLine()
    {
        if (isSaving || !CanAddLine())
        {
            return;
        }

        lines.Add(
            new Line
            {
                Reason = InReasons("Flock")[0]
            });
    }

    private void RemoveLine(Line line)
    {
        if (isSaving)
        {
            return;
        }

        lines.Remove(line);

        if (lines.Count == 0)
        {
            lines.Add(new Line());
        }
    }

    private void OnPaymentMethodChanged()
    {
        if (paymentMethod == "Cash")
        {
            bankName = null;
            referenceNumber = null;
        }
    }

    private async Task Cancel()
    {
        if (isSaving)
        {
            return;
        }

        var confirmed =
            await JsRuntime.InvokeAsync<bool>(
                "confirm",
                "Discard this entry and go back? Unsaved changes will be lost.");

        if (confirmed)
        {
            Navigation.NavigateTo("/flocks");
        }
    }

    private async Task HandleSave()
    {
        if (isSaving)
        {
            return;
        }

        errorMessage = null;

        var enteredLines =
            lines
                .Where(l =>
                    !string.IsNullOrWhiteSpace(l.ProductId))
                .ToList();

        if (enteredLines.Count == 0)
        {
            errorMessage =
                "Add at least one valid line item.";
            return;
        }

        if (enteredLines.Any(l => l.Quantity <= 0))
        {
            errorMessage =
                "Quantity must be greater than zero.";
            return;
        }

        if (enteredLines.Any(l => l.Quantity > 9999))
        {
            errorMessage =
                "Quantity cannot exceed 9,999 per line.";
            return;
        }

        if (enteredLines
            .Where(l => l.Reason == "Bought")
            .Any(l => l.UnitCost < 0))
        {
            errorMessage =
                "Unit cost cannot be negative.";
            return;
        }

        if (HasPaymentLine &&
            status != "Paid" &&
            status != "Pending")
        {
            errorMessage =
                "Status must be Paid or Pending.";
            return;
        }

        if (HasPaymentLine &&
            paymentMethod != "Cash" &&
            (string.IsNullOrWhiteSpace(bankName) ||
             string.IsNullOrWhiteSpace(referenceNumber)))
        {
            errorMessage =
                "Bank Name / Payment Source and Reference ID are required for non-cash payments.";
            return;
        }

        isSaving = true;

        try
        {
            var request =
                new ProcessStockTransactionRequest
                {
                    BusinessId =
                        businessId,

                    Direction =
                        "In",

                    MovementDate =
                        movementDate,

                    Notes =
                        string.IsNullOrWhiteSpace(notes)
                            ? null
                            : notes.Trim(),

                    Status =
                        status,

                    PaymentMethod =
                        paymentMethod,

                    PaymentSource =
                        HasPaymentLine &&
                        paymentMethod != "Cash"
                            ? bankName?.Trim()
                            : null,

                    ReferenceNumber =
                        HasPaymentLine &&
                        paymentMethod != "Cash"
                            ? referenceNumber?.Trim()
                            : null,

                    BankName =
                        HasPaymentLine &&
                        paymentMethod != "Cash"
                            ? bankName?.Trim()
                            : null,

                    Lines =
                        enteredLines.Select(l =>
                            new StockTransactionLineRequest
                            {
                                Group =
                                    l.Group,

                                ProductId =
                                    Guid.Parse(l.ProductId),

                                Reason =
                                    l.Reason,

                                Quantity =
                                    l.Quantity,

                                UnitCost =
                                    l.UnitCost,

                                SupplierId =
                                    Guid.TryParse(
                                        l.SupplierId,
                                        out var supplierId)
                                        ? supplierId
                                        : null
                            }).ToList()
                };

            var error =
                await StockApiService.ProcessAsync(
                    request);

            if (error is not null)
            {
                errorMessage = error;
                return;
            }

            Navigation.NavigateTo("/flocks");
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Failed to complete transaction: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }
}