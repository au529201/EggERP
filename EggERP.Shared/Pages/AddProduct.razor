@page "/products/add"
@using EggERP.Shared.Models
@using EggERP.Shared.Services
@inject IProductApiService ProductApiService
@inject NavigationManager Navigation

<h3>Products</h3>

<a class="btn btn-primary mb-3" href="/products/add">+ Add Product</a>

<EditForm Model="@newProduct" OnValidSubmit="HandleSave">
    <div class="mb-3">
        <label>Category ID</label>
        <InputText class="form-control" @bind-Value="newProduct.CategoryId" />
    </div>
    <div class="mb-3">
        <label>Name</label>
        <InputText class="form-control" @bind-Value="newProduct.Name" />
    </div>
    <div class="mb-3">
        <label>SKU</label>
        <InputText class="form-control" @bind-Value="newProduct.Sku" />
    </div>
    <div class="mb-3">
        <label>Description</label>
        <InputText class="form-control" @bind-Value="newProduct.Description" />
    </div>
    <div class="mb-3">
        <label>Unit</label>
        <InputText class="form-control" @bind-Value="newProduct.Unit" />
    </div>
    <div class="mb-3">
        <label>Cost Price</label>
        <InputNumber class="form-control" @bind-Value="newProduct.CostPrice" />
    </div>
    <div class="mb-3">
        <label>Selling Price</label>
        <InputNumber class="form-control" @bind-Value="newProduct.SellingPrice" />
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <p style="color:red">@errorMessage</p>
    }

    <button type="submit" class="btn btn-primary">Save</button>
</EditForm>

@code {
    private ProductFormModel newProduct = new();
    private string? errorMessage;

    // Hard-coded test business ID for now, until auth/business context exists
    private readonly Guid businessId = Guid.Parse("11111111-1111-1111-1111-111111111111");

    private async Task HandleSave()
    {
        errorMessage = null;

        if (!Guid.TryParse(newProduct.CategoryId, out var categoryId))
        {
            errorMessage = "Category ID must be a valid GUID.";
            return;
        }

        var request = new CreateProductRequest
        {
            BusinessId = businessId,
            CategoryId = categoryId,
            Name = newProduct.Name,
            Sku = newProduct.Sku,
            Description = newProduct.Description,
            Unit = newProduct.Unit,
            CostPrice = newProduct.CostPrice,
            SellingPrice = newProduct.SellingPrice,
            IsActive = true
        };

        try
        {
            await ProductApiService.CreateProductAsync(request);
            Navigation.NavigateTo("/products");
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to save product: {ex.Message}";
        }
    }

    private class ProductFormModel
    {
        public string CategoryId { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string Sku { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public string Unit { get; set; } = string.Empty;
        public decimal CostPrice { get; set; }
        public decimal SellingPrice { get; set; }
    }
}