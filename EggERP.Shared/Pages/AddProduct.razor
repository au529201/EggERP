@page "/products/add"
@using EggERP.Shared.Models
@using EggERP.Shared.Services
@inject IProductApiService ProductApiService
@inject NavigationManager Navigation

<h3>Add Product</h3>

<EditForm Model="@newProduct" OnValidSubmit="HandleSave">
    <div class="mb-3">
        <label>Group</label>
        <select class="form-select" @bind="newProduct.Group">
            <option value="Flock">Flock</option>
            <option value="Egg">Egg</option>
        </select>
    </div>
    <div class="mb-3">
        <label>Type</label>
        <InputText class="form-control" @bind-Value="newProduct.Type" placeholder="e.g. Chicken, Duck, Quail" />
    </div>
    <div class="mb-3">
        <label>Description</label>
        <InputText class="form-control" @bind-Value="newProduct.Description" placeholder="e.g. Breeder, Layer, Small, Large" />
    </div>
    <div class="mb-3">
        <label>Unit</label>
        <InputText class="form-control" @bind-Value="newProduct.Unit" placeholder="pcs" />
    </div>
    <div class="mb-3">
        <label>Cost Price</label>
        <InputNumber class="form-control" @bind-Value="newProduct.CostPrice" />
    </div>
    <div class="mb-3">
        <label>Sell Price</label>
        <InputNumber class="form-control" @bind-Value="newProduct.SellingPrice" />
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <p style="color:red">@errorMessage</p>
    }

    <button type="submit" class="btn btn-primary">Save</button>
</EditForm>

@code {
    private readonly Guid businessId = Guid.Parse("11111111-1111-1111-1111-111111111111");

    private CreateProductRequest newProduct = new();
    private string? errorMessage;

    private async Task HandleSave()
    {
        errorMessage = null;
        newProduct.BusinessId = businessId;

        try
        {
            await ProductApiService.CreateProductAsync(newProduct);
            Navigation.NavigateTo("/products");
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to save product: {ex.Message}";
        }
    }
}