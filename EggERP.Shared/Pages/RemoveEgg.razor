@page "/eggs/remove"
@attribute [Authorize(Roles = "Admin,Manager")]
@using EggERP.Shared.Models
@using EggERP.Shared.Services
@inject IEggApiService EggApiService
@inject IProductApiService ProductApiService
@inject NavigationManager Navigation

<h3>Remove Egg</h3>

@if (products is null)
{
    <p>Loading...</p>
}
else if (eggProducts.Count == 0)
{
    <p>No Egg-type products exist yet.</p>
}
else
{
    <EditForm Model="@request" OnValidSubmit="HandleSave">
        <div class="mb-3">
            <label>Product</label>
            <select class="form-select" @bind="selectedProductId">
                <option value="">Select product</option>
                @foreach (var product in eggProducts)
                {
                    <option value="@product.Id">@product.Type - @product.Description</option>
                }
            </select>
        </div>

        <div class="mb-3">
            <label>Source</label>
            <select class="form-select" @bind="request.Reason">
                <option value="Sold">Sold</option>
                <option value="Moved">Moved</option>
                <option value="Broken">Broken</option>
                <option value="Stolen">Stolen</option>
                <option value="Missing">Missing</option>
                <option value="Hatched">Hatched</option>
            </select>
            @if (request.Reason == "Sold")
            {
                <small class="form-text text-muted">You'll be sent to New Sale to finish this — price comes from the product's sell price.</small>
            }
        </div>

        <div class="mb-3">
            <label>Quantity</label>
            <InputNumber class="form-control" @bind-Value="request.Quantity" />
        </div>

        <div class="mb-3">
            <label>Date</label>
            <InputDate class="form-control" @bind-Value="request.MovementDate" />
        </div>

        <div class="mb-3">
            <label>Notes</label>
            <InputTextArea class="form-control" @bind-Value="request.Notes" />
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <p style="color:red">@errorMessage</p>
        }

        <button type="submit" class="btn btn-primary">Save</button>
    </EditForm>
}

@code {
    private RemoveStockRequest request = new() { Reason = "Sold", Quantity = 1 };
    private List<ProductDto>? products;
    private List<ProductDto> eggProducts = new();
    private string selectedProductId = "";
    private string? errorMessage;

    private readonly Guid businessId = Guid.Parse("11111111-1111-1111-1111-111111111111");

    protected override async Task OnInitializedAsync()
    {
        products = await ProductApiService.GetProductsAsync(businessId);
        eggProducts = products.Where(p => p.Group == "Egg").ToList();
    }

    private async Task HandleSave()
    {
        errorMessage = null;

        if (!Guid.TryParse(selectedProductId, out var productId))
        {
            errorMessage = "Select a product before continuing.";
            return;
        }

        if (request.Reason == "Sold")
        {
            Navigation.NavigateTo($"/sales/new?productId={productId}&qty={request.Quantity}");
            return;
        }

        request.ProductId = productId;

        var error = await EggApiService.RemoveStockAsync(request);
        if (error is not null)
        {
            errorMessage = error;
            return;
        }

        Navigation.NavigateTo("/eggs");
    }
}