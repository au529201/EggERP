@page "/inventory"
@attribute [Authorize(Roles = "Admin,Manager,Staff")]
@using EggERP.Shared.Models
@using EggERP.Shared.Services
@inject IInventoryApiService InventoryApiService

<h3>Inventory</h3>

<div class="row mb-2 g-2">
    <div class="col-md-4">
        <input class="form-control" placeholder="Search inventory..." @bind="searchText" @bind:event="oninput" />
    </div>
    <div class="col-md-3">
        <select class="form-select" @bind="selectedGroup">
            <option value="">All (Flock/Egg)</option>
            <option value="Flock">Flock</option>
            <option value="Egg">Egg</option>
        </select>
    </div>
    <div class="col-md-3">
        <input type="date" class="form-control" @bind="selectedDate" @bind:after="LoadData" />
    </div>
</div>
<small class="form-text text-muted d-block mb-3">
    Available always reflects current stock. Bought/Sold reflect purchases and sales up to the selected date only.
</small>

@if (isLoading)
{
    <p>Loading...</p>
}
else if (!FilteredRows.Any())
{
    <p>No matching products found.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Group</th>
                <th>Type</th>
                <th>Description</th>
                <th>Available</th>
                <th>Unit</th>
                <th>Price</th>
                <th>Bought</th>
                <th>Sold</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in FilteredRows)
            {
                <tr>
                    <td>@row.Group</td>
                    <td>@row.Type</td>
                    <td>@row.Description</td>
                    <td>@row.Available</td>
                    <td>@row.Unit</td>
                    <td>@row.SellingPrice.ToString("N2")</td>
                    <td>@row.BoughtAsOfDate</td>
                    <td>@row.SoldAsOfDate</td>
                    <td>
                        @if (row.Available <= row.ReorderLevel)
                        {
                            <span class="badge bg-danger">Low Stock</span>
                        }
                        else
                        {
                            <span class="badge bg-success">OK</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<InventoryBoardRowDto> rows = new();
    private bool isLoading = true;
    private DateTime selectedDate = DateTime.Today;
    private string searchText = string.Empty;
    private string selectedGroup = string.Empty;

    private IEnumerable<InventoryBoardRowDto> FilteredRows =>
        rows.Where(r =>
            (string.IsNullOrWhiteSpace(searchText) ||
             r.Type.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
             r.Description.Contains(searchText, StringComparison.OrdinalIgnoreCase))
            &&
            (string.IsNullOrWhiteSpace(selectedGroup) || r.Group == selectedGroup));

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        rows = await InventoryApiService.GetBoardAsOfDateAsync(selectedDate);
        isLoading = false;
    }
}