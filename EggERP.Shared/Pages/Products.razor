@page "/products"
@using EggERP.Shared.Models
@using EggERP.Shared.Services
@inject IProductApiService ProductApiService
@inject IJSRuntime JsRuntime
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthenticationStateProvider
@using EggERP.Shared.Components
<h3>Products</h3>

@if (canManage)
{
    <a class="btn btn-primary mb-3" href="/products/add">+ Add Product</a>
}

<div class="row mb-3 g-2">
    <div class="col-md-4">
        <input class="form-control"
               placeholder="Search products..."
               @bind="searchText"
               @bind:event="oninput"
               @bind:after="ResetPage" />
    </div>

    <div class="col-md-4">
        <select class="form-select"
                @bind="selectedGroup"
                @bind:after="ResetPage">
            <option value="">All (Flock/Egg)</option>
            <option value="Flock">Flock</option>
            <option value="Egg">Egg</option>
        </select>
    </div>
    @if (canManage)
    {
        <div class="col-md-4">
            <select class="form-select" @bind="statusFilter" @bind:after="ResetPage">
                <option value="Active">Active</option>
                <option value="Inactive">Inactive</option>
                <option value="All">All</option>
            </select>
        </div>
    }
</div>

@if (products is null)
{
    <p>Loading...</p>
}
else if (!FilteredProducts.Any())
{
    <p>No products found.</p>
}
else
{
    <div class="erp-table-scroll">
        <table class="table erp-data-table">
            <thead>
                <tr>
                    <th>Group</th>
                    <th>Type</th>
                    <th>Description</th>
                    <th>Unit</th>
                    <th>Cost Price</th>
<th>Sell Price</th>
<th>Low Stock At</th>
<th>Status</th>
                    @if (canManage) { <th>Actions</th> }
                </tr>
            </thead>

            <tbody>
                @foreach (var product in PagedProducts)
                {
                    <tr>
                        <td>@product.Group</td>
                        <td>@product.Type</td>
                        <td>@product.Description</td>
                        <td>@product.Unit</td>
                        <td>@product.CostPrice.ToString("N2")</td>
                        <td>@product.SellingPrice.ToString("N2")</td>
                        <td>@product.ReorderLevel.ToString("N0")</td>
                        <td><span class="badge @(product.IsActive ? "bg-success" : "bg-secondary")">@(product.IsActive ? "Active" : "Inactive")</span></td>
                        @if (canManage)
                        {
                            <td>
                                <div class="erp-table-actions">
                                    <a class="btn btn-sm btn-secondary" href="@($"/products/edit/{product.Id}")">Edit</a>
                                    @if (product.IsActive)
                                    {
                                        <button class="btn btn-sm btn-danger" @onclick="() => DeactivateProduct(product.Id, product.Name)">Deactivate</button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-success" @onclick="() => ReactivateProduct(product.Id, product.Name)">Reactivate</button>
                                    }
                                </div>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <EzPagination TotalCount="FilteredProducts.Count()"
                  Page="@(page)"
                  PageSize="pageSize"
                  PageChanged="OnPageChanged" />
}

@code {
    private List<ProductDto>? products;
    private string searchText = string.Empty;
    private string selectedGroup = string.Empty;
    private string statusFilter = "Active";
    private bool canManage;

    private int page = 1;
    private const int pageSize = 10;

    private IEnumerable<ProductDto> FilteredProducts =>
        products is null
            ? Enumerable.Empty<ProductDto>()
            : products.Where(p =>
                (
                    string.IsNullOrWhiteSpace(searchText) ||
                    p.Type.Contains(
                        searchText,
                        StringComparison.OrdinalIgnoreCase) ||
                    (p.Description ?? string.Empty).Contains(
                        searchText,
                        StringComparison.OrdinalIgnoreCase)
                )
                &&
                (
                    string.IsNullOrWhiteSpace(selectedGroup) ||
                    p.Group == selectedGroup
                )
                && (statusFilter == "All" ||
                    (statusFilter == "Active" && p.IsActive) ||
                    (statusFilter == "Inactive" && !p.IsActive)));

    private IEnumerable<ProductDto> PagedProducts =>
        FilteredProducts
            .Skip((page - 1) * pageSize)
            .Take(pageSize);

    private void ResetPage()
    {
        page = 1;
    }

    private void OnPageChanged(int newPage)
    {
        page = newPage;
    }

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        canManage = state.User.IsInRole("Admin") || state.User.IsInRole("Manager");
        products = await ProductApiService.GetProductsAsync(canManage);
    }

    private async Task RefreshProductsAsync()
    {
        products = await ProductApiService.GetProductsAsync(canManage);
    }

    private async Task ReactivateProduct(Guid id, string name)
    {
        if (!canManage) return;
        var confirmed = await JsRuntime.InvokeAsync<bool>("confirm", $"Reactivate '{name}'?");
        if (!confirmed) return;
        await ProductApiService.ReactivateProductAsync(id);
        await RefreshProductsAsync();
    }

    private async Task DeactivateProduct(Guid id, string name)
    {
        var confirmed = await JsRuntime.InvokeAsync<bool>(
            "confirm",
            $"Deactivate '{name}'? It will be hidden from the active product list.");

        if (!confirmed)
        {
            return;
        }

        await ProductApiService.DeactivateProductAsync(id);
        await RefreshProductsAsync();
    }
}