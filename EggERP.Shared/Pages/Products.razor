@page "/products"
@using EggERP.Shared.Models
@using EggERP.Shared.Services
@inject IProductApiService ProductApiService
@inject ICategoryApiService CategoryApiService
<h3>Products</h3>
<a class="btn btn-primary mb-3" href="/products/add">+ Add Product</a>
<div class="row mb-3">
    <div class="col-md-6">
        <input class="form-control" placeholder="Search products..." @bind="searchText" @bind:event="oninput" />
    </div>
    <div class="col-md-6">
        <select class="form-select" @bind="selectedCategoryId">
            <option value="">All Categories</option>
            @if (categories is not null)
            {
                @foreach (var category in categories)
                {
                    <option value="@category.Id">@category.Name</option>
                }
            }
        </select>
    </div>
</div>
@if (products is null)
{
    <p>Loading...</p>
}
else if (products.Count == 0)
{
    <p>No products found.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>SKU</th>
                <th>Unit</th>
                <th>Cost</th>
                <th>Selling</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in FilteredProducts)
            {
                <tr>
                    <td>@product.Name</td>
                    <td>@product.Sku</td>
                    <td>@product.Unit</td>
                    <td>@product.CostPrice</td>
                    <td>@product.SellingPrice</td>
                    <td>
                        <a class="btn btn-sm btn-secondary" href="@($"/products/edit/{product.Id}")">Edit</a>
                        <button class="btn btn-sm btn-danger" @onclick="() => DeactivateProduct(product.Id)">Deactivate</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
@code {
    private List<ProductDto>? products;
    private List<CategoryDto>? categories;
    private string searchText = string.Empty;
    private string selectedCategoryId = string.Empty;
    // Hard-coded test business ID for now, until auth/business context exists
    private readonly Guid businessId = Guid.Parse("11111111-1111-1111-1111-111111111111");
    private IEnumerable<ProductDto> FilteredProducts =>
        products is null
            ? Enumerable.Empty<ProductDto>()
            : products.Where(p =>
                (string.IsNullOrWhiteSpace(searchText) ||
                 p.Name.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                 p.Sku.Contains(searchText, StringComparison.OrdinalIgnoreCase))
                &&
                (string.IsNullOrWhiteSpace(selectedCategoryId) ||
                 p.CategoryId.ToString() == selectedCategoryId));
    protected override async Task OnInitializedAsync()
    {
        products = await ProductApiService.GetProductsAsync(businessId);
        categories = await CategoryApiService.GetCategoriesAsync(businessId);
    }
    private async Task DeactivateProduct(Guid id)
    {
        await ProductApiService.DeactivateProductAsync(businessId, id);
        products = await ProductApiService.GetProductsAsync(businessId);
    }
}