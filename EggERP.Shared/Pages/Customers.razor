@page "/customers"
@using EggERP.Shared.Models
@using EggERP.Shared.Services
@inject ICustomerApiService CustomerApiService
@inject IJSRuntime JsRuntime

<h3>Customers</h3>
<a class="btn btn-primary mb-3" href="/customers/add">+ Add Customer</a>

@if (customers is null)
{
    <p>Loading...</p>
}
else if (customers.Count == 0)
{
    <p>No customers found.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Address</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var customer in customers)
            {
                <tr>
                    <td>@customer.Name</td>
                    <td>@customer.Email</td>
                    <td>@customer.Phone</td>
                    <td>@customer.Address</td>
                    <td>
                        <a class="btn btn-sm btn-secondary" href="@($"/customers/edit/{customer.Id}")">Edit</a>
                        <button class="btn btn-sm btn-danger" @onclick="() => DeactivateCustomer(customer.Id, customer.Name)">Deactivate</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<CustomerDto>? customers;
    private readonly Guid businessId = Guid.Parse("11111111-1111-1111-1111-111111111111");

    protected override async Task OnInitializedAsync()
    {
        customers = await CustomerApiService.GetCustomersAsync(businessId);
    }

    private async Task DeactivateCustomer(Guid id, string name)
    {
        var confirmed = await JsRuntime.InvokeAsync<bool>("confirm", $"Deactivate '{name}'? It will be hidden from the active customer list.");
        if (!confirmed)
        {
            return;
        }

        await CustomerApiService.DeactivateCustomerAsync(businessId, id);
        customers = await CustomerApiService.GetCustomersAsync(businessId);
    }
}