@page "/customers"
@attribute [Authorize(Roles = "Admin,Manager,Staff")]
@using EggERP.Shared.Models
@using EggERP.Shared.Services
@inject ICustomerApiService CustomerApiService
@inject IJSRuntime JsRuntime

<h3>Customers</h3>

<a class="btn btn-primary mb-3" href="/customers/add">+ Add Customer</a>

<div class="row mb-3 g-2">
    <div class="col-md-9">
        <input class="form-control"
               placeholder="Search name, email, phone or address..."
               @bind="searchText"
               @bind:event="oninput"
               @bind:after="ResetPage" />
    </div>

    <div class="col-md-3">
        <button class="btn btn-outline-secondary w-100"
                @onclick="ClearFilters">
            Clear
        </button>
    </div>
</div>

@if (customers is null)
{
    <p>Loading...</p>
}
else if (!FilteredCustomers.Any())
{
    <p>No matching customers found.</p>
}
else
{
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Address</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var customer in PagedCustomers)
                {
                    <tr>
                        <td>@customer.Name</td>
                        <td>@customer.Email</td>
                        <td>@customer.Phone</td>
                        <td>@customer.Address</td>
                        <td>
                            <AuthorizeView Roles="Admin,Manager">
                                <Authorized>
                                    <a class="btn btn-sm btn-secondary"
                                       href="@($"/customers/edit/{customer.Id}")">
                                        Edit
                                    </a>

                                    <button class="btn btn-sm btn-danger"
                                            @onclick="() => DeactivateCustomer(customer.Id, customer.Name)">
                                        Deactivate
                                    </button>
                                </Authorized>
                            </AuthorizeView>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <Pager Total="FilteredCustomers.Count()"
           Page="page"
           PageSize="pageSize"
           PageChanged="OnPageChanged" />
}

@code {
    private List<CustomerDto>? customers;
    private string searchText = string.Empty;

    private readonly Guid businessId =
        Guid.Parse("11111111-1111-1111-1111-111111111111");

    private int page = 1;
    private const int pageSize = 7;

    private IEnumerable<CustomerDto> FilteredCustomers =>
        (customers ?? new List<CustomerDto>())
        .Where(c =>
            string.IsNullOrWhiteSpace(searchText) ||
            c.Name.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
            (c.Email ?? string.Empty).Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
            (c.Phone ?? string.Empty).Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
            (c.Address ?? string.Empty).Contains(searchText, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<CustomerDto> PagedCustomers =>
        FilteredCustomers
            .Skip((page - 1) * pageSize)
            .Take(pageSize);

    protected override async Task OnInitializedAsync()
    {
        customers = await CustomerApiService.GetCustomersAsync(businessId);
    }

    private void ResetPage() => page = 1;

    private void OnPageChanged(int newPage) => page = newPage;

    private void ClearFilters()
    {
        searchText = string.Empty;
        page = 1;
    }

    private async Task DeactivateCustomer(Guid id, string name)
    {
        var confirmed = await JsRuntime.InvokeAsync<bool>(
            "confirm",
            $"Deactivate '{name}'? It will be hidden from the active customer list.");

        if (!confirmed)
        {
            return;
        }

        await CustomerApiService.DeactivateCustomerAsync(businessId, id);
        customers = await CustomerApiService.GetCustomersAsync(businessId);
        page = 1;
    }
}