@page "/expenses/add"
@attribute [Authorize(Roles = "Admin,Manager")]
@using EggERP.Shared.Models
@using EggERP.Shared.Services
@inject IExpenseApiService ExpenseApiService
@inject IJSRuntime JsRuntime
@inject NavigationManager Navigation

<h3>Add Expense</h3>

<table class="table">
    <thead>
        <tr>
            <th>Description</th>
            <th>Category</th>
            <th>Amount</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var line in lines)
        {
            <tr>
                <td><input class="form-control" @bind="line.Description" /></td>
                <td><input class="form-control" @bind="line.Category" placeholder="e.g. Feed, Utilities" /></td>
                <td><input type="number" step="0.01" class="form-control" @bind="line.Amount" /></td>
                <td><button class="btn btn-sm btn-danger" @onclick="() => RemoveLine(line)">Remove</button></td>
            </tr>
        }
    </tbody>
</table>

<button class="btn btn-secondary mb-3" @onclick="AddLine">+ Add Line</button>

<h5>Total Amount: @(lines.Sum(l => l.Amount).ToString("N2"))</h5>

<div class="txn-row">
    <div>
        <label>Status</label>
        <select class="form-select" @bind="status">
            <option value="Paid">Paid</option>
            <option value="Pending">Pending</option>
            <option value="Partial">Partial</option>
        </select>
    </div>
    <div>
        <label>Payment Method</label>
        <select class="form-select" @bind="paymentMethod">
            <option value="Cash">Cash</option>
            <option value="Credit Card">Credit Card</option>
            <option value="Debit Card">Debit Card</option>
            <option value="Other">Other</option>
        </select>
    </div>
    <div>
        <label>Bank Name</label>
        <input class="form-control" @bind="bankName" placeholder="e.g. BDO, MariBank, GCash" />
    </div>
    <div>
        <label>Reference ID</label>
        <input class="form-control" @bind="referenceNumber" />
    </div>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <p style="color:red">@errorMessage</p>
}

<div class="txn-actions">
    <button class="btn btn-outline-secondary" @onclick="Cancel">Cancel</button>
    <button class="btn btn-primary" @onclick="HandleSave">Complete Transaction</button>
</div>

@code {
    private class Line
    {
        public string Description { get; set; } = string.Empty;
        public string Category { get; set; } = string.Empty;
        public decimal Amount { get; set; }
    }

    private List<Line> lines = new() { new Line() };
    private string status = "Paid";
    private string paymentMethod = "Cash";
    private string? bankName;
    private string? referenceNumber;
    private string? errorMessage;
    private readonly Guid businessId = Guid.Parse("11111111-1111-1111-1111-111111111111");

    private void AddLine() => lines.Add(new Line());
    private void RemoveLine(Line line) => lines.Remove(line);

    private async Task Cancel()
    {
        var confirmed = await JsRuntime.InvokeAsync<bool>("confirm", "Discard these expenses and go back? Unsaved changes will be lost.");
        if (confirmed)
        {
            Navigation.NavigateTo("/expenses");
        }
    }

    private async Task HandleSave()
    {
        errorMessage = null;

        var validLines = lines.Where(l => !string.IsNullOrWhiteSpace(l.Description) && l.Amount > 0).ToList();
        if (validLines.Count == 0)
        {
            errorMessage = "Add at least one valid expense line.";
            return;
        }

        if (paymentMethod != "Cash" && (string.IsNullOrWhiteSpace(bankName) || string.IsNullOrWhiteSpace(referenceNumber)))
        {
            errorMessage = "Bank Name and Reference ID are required for non-cash payments.";
            return;
        }

        try
        {
            foreach (var line in validLines)
            {
                await ExpenseApiService.CreateExpenseAsync(new CreateExpenseRequest
                {
                    BusinessId = businessId,
                    Description = line.Description,
                    Category = line.Category,
                    Amount = line.Amount,
                    PaymentMethod = paymentMethod,
                    PaymentSource = paymentMethod == "Cash" ? null : bankName,
                    ReferenceNumber = paymentMethod == "Cash" ? null : referenceNumber,
                    Status = status
                });
            }
            Navigation.NavigateTo("/expenses");
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to save expenses: {ex.Message}";
        }
    }
}