@page "/flocks"
@using EggERP.Shared.Models
@using EggERP.Shared.Services
@inject IFlockApiService FlockApiService

<h3>Flocks</h3>

<AuthorizeView Roles="Admin,Manager">
    <Authorized>
        <a class="btn btn-primary mb-3" href="/flocks/add">+ Add Flock</a>
    </Authorized>
</AuthorizeView>
<a class="btn btn-secondary mb-3 ms-2" href="/flocks/movements/add">Record Bird Movement</a>
<a class="btn btn-secondary mb-3 ms-2" href="/flocks/eggs/add">Record Egg Movement</a>

@if (flocks is null)
{
    <p>Loading...</p>
}
else if (flocks.Count == 0)
{
    <p>No flocks found.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Species</th>
                <th>Breed</th>
                <th>Placed</th>
                <th>Population</th>
                <th>Cost</th>
                <th>Linked Product</th>
                <th>Notes</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var flock in flocks)
            {
                <tr>
                    <td>@flock.Name</td>
                    <td>@flock.Species</td>
                    <td>@flock.Breed</td>
                    <td>@flock.PlacementDate.ToString("d")</td>
                    <td>@flock.CurrentPopulation</td>
                    <td>@(flock.AcquisitionCost?.ToString("N2") ?? "-")</td>
                    <td>@(flock.LinkedProductName ?? "-")</td>
                    <td>@flock.Notes</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<FlockDto>? flocks;

    protected override async Task OnInitializedAsync()
    {
        flocks = await FlockApiService.GetFlocksAsync();
    }
}