@page "/flocks"
@using EggERP.Shared.Models
@using EggERP.Shared.Services
@inject IFlockApiService FlockApiService

<h3>Flocks</h3>

<a class="btn btn-primary mb-3" href="/flocks/add">+ Add Flock</a>
<a class="btn btn-secondary mb-3 ms-2" href="/flocks/remove">- Remove Flock</a>

@if (rows is null)
{
    <p>Loading...</p>
}
else if (rows.Count == 0)
{
    <p>No Flock-type products found. <a href="/products/add">Add one</a> first (set Group = Flock).</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Type</th>
                <th>Description</th>
                <th>Unit</th>
                <th>Available</th>
                <th>Bought</th>
                <th>Sold</th>
                <th>Total Sales</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in PagedRows)
            {
                <tr>
                    <td>@row.Type</td>
                    <td>@row.Description</td>
                    <td>@row.Unit</td>
                    <td>@row.Available</td>
                    <td>@row.Bought</td>
                    <td>@row.Sold</td>
                    <td>@row.TotalSales.ToString("N2")</td>
                </tr>
            }
        </tbody>
    </table>

    <Pager Total="rows.Count" Page="page" PageSize="pageSize" PageChanged="OnPageChanged" />
}

@code {
    private List<StockBoardRowDto>? rows;
    private int page = 1;
    private const int pageSize = 7;

    private IEnumerable<StockBoardRowDto> PagedRows =>
        (rows ?? new List<StockBoardRowDto>()).Skip((page - 1) * pageSize).Take(pageSize);

    private void OnPageChanged(int newPage) => page = newPage;

    protected override async Task OnInitializedAsync()
    {
        rows = await FlockApiService.GetBoardAsync();
    }
}