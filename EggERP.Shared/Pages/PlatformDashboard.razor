
@page "/platform"
@attribute [Authorize(Roles = "PlatformAdmin")]
@rendermode InteractiveServer

@using EggERP.Shared.Services
@inject IPlatformBusinessApiService PlatformApi

<PageTitle>Platform Dashboard - EzEggERP</PageTitle>

<div class="container-fluid py-3">

    <div class="mb-4">
        <h2 class="mb-1">Platform Dashboard</h2>
        <p class="text-muted mb-0">
            Overview of registered EzEggERP businesses
            and their current status.
        </p>
    </div>

    @if (loading)
    {
        <p>Loading platform information...</p>
    }
    else if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="alert alert-danger" role="alert">
            @error
        </div>
    }
    else
    {
        <div class="row g-3 mb-4">
            <div class="col-12 col-md-4">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="text-muted">
                            Registered Businesses
                        </div>
                        <h2 class="mt-2 mb-0">
                            @businesses.Count
                        </h2>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-4">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="text-muted">
                            Active Businesses
                        </div>
                        <h2 class="mt-2 mb-0 text-success">
                            @businesses.Count(b => b.IsActive)
                        </h2>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-4">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="text-muted">
                            Suspended Businesses
                        </div>
                        <h2 class="mt-2 mb-0 text-danger">
                            @businesses.Count(b => !b.IsActive)
                        </h2>
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header d-flex flex-wrap
                        justify-content-between align-items-center gap-2">
                <strong>Registered Businesses</strong>

                <a class="btn btn-primary btn-sm"
                   href="/platform/businesses">
                    Manage Businesses
                </a>
            </div>

            <div class="card-body">
                @if (businesses.Count == 0)
                {
                    <p class="text-muted mb-0">
                        No businesses registered yet.
                    </p>
                }
                else
                {
                    <div class="table-responsive"
                         role="region"
                         aria-label="Registered businesses"
                         tabindex="0">

                        <table class="table table-striped
                                      table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Business</th>
                                    <th>Administrator</th>
                                    <th>Email</th>
                                    <th>Account</th>
                                    <th>Business Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var business in PagedBusinesses)
                                {
                                    <tr @key="business.BusinessId">
                                        <td>@business.BusinessName</td>
                                        <td>@business.OwnerName</td>
                                        <td>
                                            @(business.OwnerEmail ?? "—")
                                        </td>
                                        <td>
                                            @if (business.OwnerEmailConfirmed)
                                            {
                                                <span class="badge bg-success">
                                                    Confirmed
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark">
                                                    Unconfirmed
                                                </span>
                                            }
                                        </td>
                                        <td>
                                            @if (business.IsActive)
                                            {
                                                <span class="badge bg-success">
                                                    Active
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">
                                                    Suspended
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="d-flex flex-wrap
                                justify-content-between
                                align-items-center gap-2 mt-3">
                        <small class="text-muted">
                            Showing @StartRecord–@EndRecord
                            of @businesses.Count businesses
                        </small>

                        @if (TotalPages > 1)
                        {
                            <div class="d-flex flex-wrap gap-1">
                                <button class="btn btn-sm btn-outline-secondary"
                                        disabled="@(page == 1)"
                                        @onclick="() => SetPage(page - 1)">
                                    Prev
                                </button>

                                @for (var p = FirstPage; p <= LastPage; p++)
                                {
                                    var target = p;

                                    <button class="btn btn-sm @(page == target
                                                ? "btn-primary"
                                                : "btn-outline-secondary")"
                                            @onclick="() => SetPage(target)">
                                        @target
                                    </button>
                                }

                                <button class="btn btn-sm btn-outline-secondary"
                                        disabled="@(page == TotalPages)"
                                        @onclick="() => SetPage(page + 1)">
                                    Next
                                </button>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private List<PlatformBusinessDto> businesses = new();

    private bool loading = true;
    private string? error;

    private int page = 1;
    private const int PageSize = 10;
    private const int VisiblePages = 5;

    private int TotalPages =>
        Math.Max(1, (int)Math.Ceiling(
            businesses.Count / (double)PageSize));

    private int FirstPage =>
        Math.Max(1, Math.Min(
            page - VisiblePages / 2,
            TotalPages - VisiblePages + 1));

    private int LastPage =>
        Math.Min(TotalPages, FirstPage + VisiblePages - 1);

    private int StartRecord =>
        businesses.Count == 0 ? 0 : (page - 1) * PageSize + 1;

    private int EndRecord =>
        Math.Min(page * PageSize, businesses.Count);

    private IEnumerable<PlatformBusinessDto> PagedBusinesses =>
        businesses
            .Skip((page - 1) * PageSize)
            .Take(PageSize);

    private void SetPage(int target)
    {
        page = Math.Clamp(target, 1, TotalPages);
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            businesses = await PlatformApi.GetBusinessesAsync();
        }
        catch
        {
            error = "Unable to load platform information.";
        }
        finally
        {
            loading = false;
        }
    }
}
