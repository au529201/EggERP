@page "/flocks/movements/add"
@using EggERP.Shared.Models
@using EggERP.Shared.Services
@inject IFlockApiService FlockApiService
@inject NavigationManager Navigation

<h3>Record Flock Movement</h3>

@if (flocks is null)
{
    <p>Loading...</p>
}
else if (flocks.Count == 0)
{
    <p>No flocks available. <a href="/flocks/add">Add a flock</a> first.</p>
}
else
{
    <EditForm Model="@movement" OnValidSubmit="HandleSave">
        <div class="mb-3">
            <label>Flock</label>
            <select class="form-select" @bind="movement.FlockId">
                @foreach (var flock in flocks)
                {
                    <option value="@flock.Id">@flock.BirdType (@flock.CurrentCount on hand)</option>
                }
            </select>
        </div>

        <div class="mb-3">
            <label>Reason</label>
            <select class="form-select" @bind="movement.Reason">
                @foreach (var reason in reasons)
                {
                    <option value="@reason">@reason</option>
                }
            </select>
        </div>

        <div class="mb-3">
            <label>Quantity</label>
            <InputNumber class="form-control" @bind-Value="movement.Quantity" />
        </div>

        <div class="mb-3">
            <label>Date</label>
            <InputDate class="form-control" @bind-Value="movement.MovementDate" />
        </div>

        <div class="mb-3">
            <label>Notes</label>
            <InputTextArea class="form-control" @bind-Value="movement.Notes" />
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <p style="color:red">@errorMessage</p>
        }

        <button type="submit" class="btn btn-primary">Record</button>
    </EditForm>
}

@code {
    // Mirrors EggERP.Application.Flocks.FlockOptions server-side allowed values.
    private readonly string[] reasons =
        { "Sold", "Died", "Missing", "Given Away", "Transferred", "Adjustment", "Other" };

    private List<FlockDto>? flocks;
    private RecordFlockMovementRequest movement = new();
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        flocks = await FlockApiService.GetFlocksAsync();
        if (flocks.Count > 0)
        {
            movement.FlockId = flocks[0].Id;
        }
    }

    private async Task HandleSave()
    {
        errorMessage = null;

        var error = await FlockApiService.RecordMovementAsync(movement);

        if (error is not null)
        {
            errorMessage = error;
            return;
        }

        Navigation.NavigateTo("/flocks");
    }
}