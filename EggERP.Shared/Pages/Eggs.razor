@page "/eggs"
@using EggERP.Shared.Models
@using EggERP.Shared.Services
@inject IEggApiService EggApiService

<h3>Eggs</h3>

<a class="btn btn-primary mb-3" href="/eggs/add">+ Add Egg</a>
<a class="btn btn-secondary mb-3 ms-2" href="/eggs/remove">- Remove Egg</a>

@if (rows is null)
{
    <p>Loading...</p>
}
else if (rows.Count == 0)
{
    <p>No Egg-type products found. <a href="/products/add">Add one</a> first (set Group = Egg).</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Type</th>
                <th>Description</th>
                <th>Unit</th>
                <th>Available</th>
                <th>Bought</th>
                <th>Sold</th>
                <th>Total Sales</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in PagedRows)
            {
                <tr>
                    <td>@row.Type</td>
                    <td>@row.Description</td>
                    <td>@row.Unit</td>
                    <td>@row.Available</td>
                    <td>@row.Bought</td>
                    <td>@row.Sold</td>
                    <td>@row.TotalSales.ToString("N2")</td>
                </tr>
            }
        </tbody>
    </table>

    <Pager Total="rows.Count" Page="page" PageSize="pageSize" PageChanged="OnPageChanged" />
}

@code {
    private List<StockBoardRowDto>? rows;
    private int page = 1;
    private const int pageSize = 7;

    private IEnumerable<StockBoardRowDto> PagedRows =>
        (rows ?? new List<StockBoardRowDto>()).Skip((page - 1) * pageSize).Take(pageSize);

    private void OnPageChanged(int newPage) => page = newPage;

    protected override async Task OnInitializedAsync()
    {
        rows = await EggApiService.GetBoardAsync();
    }
}