@page "/payments"
@using EggERP.Shared.Models
@using EggERP.Shared.Services
@inject IPaymentApiService PaymentApiService

<h3>Payments</h3>
<a class="btn btn-primary mb-3" href="/payments/add">+ Add Payment</a>

@if (payments is null)
{
    <p>Loading...</p>
}
else if (payments.Count == 0)
{
    <p>No payments found.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Date</th>
                <th>Linked To</th>
                <th>Amount</th>
                <th>Method</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var payment in payments)
            {
                <tr>
                    <td>@payment.PaymentDateUtc.ToLocalTime().ToString("d")</td>
                    <td>
                        @if (payment.SaleId is not null)
                        {
                            <span>Sale</span>
                        }
                        else if (payment.PurchaseId is not null)
                        {
                            <span>Purchase</span>
                        }
                        else
                        {
                            <span>General</span>
                        }
                    </td>
                    <td>@payment.Amount.ToString("N2")</td>
                    <td>@payment.PaymentMethod</td>
                    <td>@payment.Status</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<PaymentDto>? payments;
    private readonly Guid businessId = Guid.Parse("11111111-1111-1111-1111-111111111111");

    protected override async Task OnInitializedAsync()
    {
        payments = await PaymentApiService.GetPaymentsAsync(businessId);
    }
}