@page "/settings/users"
@attribute [Authorize(Roles = "Admin")]
@using EggERP.Shared.Models
@using EggERP.Shared.Services
@inject IUserManagementApiService UserManagementApiService
@inject IJSRuntime JsRuntime

<h3>User Management</h3>
<a class="btn btn-primary mb-3" href="/settings/users/add">+ Add User</a>

@if (users is null)
{
    <p>Loading...</p>
}
else if (users.Count == 0)
{
    <p>No users found.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Full Name</th>
                <th>Email</th>
                <th>Role</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in PagedUsers)
            {
                <tr>
                    <td>@user.FullName</td>
                    <td>@user.Email</td>
                    <td>@user.Role</td>
                    <td>
                        @if (user.IsActive)
                        {
                            <span class="status-pill status-active"><i class="bi bi-circle-fill"></i> Active</span>
                        }
                        else
                        {
                            <span class="status-pill status-inactive"><i class="bi bi-circle-fill"></i> Deactivated</span>
                        }
                    </td>
                    <td>
                        @if (user.IsActive)
                        {
                            <a class="btn btn-sm btn-secondary me-1" href="@($"/settings/users/edit/{user.Id}")">
                                <i class="bi bi-pencil-fill me-1"></i> Edit
                            </a>
                            <button class="btn btn-sm btn-danger" @onclick="() => DeactivateUser(user.Id, user.FullName)">
                                <i class="bi bi-slash-circle me-1"></i> Deactivate
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-success" @onclick="() => ActivateUser(user.Id, user.FullName)">
                                <i class="bi bi-arrow-clockwise me-1"></i> Activate
                            </button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <Pager Total="users.Count" Page="page" PageSize="pageSize" PageChanged="OnPageChanged" />
}

@code {
    private List<UserDto>? users;
    private int page = 1;
    private const int pageSize = 7;

    private IEnumerable<UserDto> PagedUsers =>
        (users ?? new List<UserDto>()).Skip((page - 1) * pageSize).Take(pageSize);

    private void OnPageChanged(int newPage) => page = newPage;

    protected override async Task OnInitializedAsync()
    {
        users = await UserManagementApiService.GetUsersAsync();
    }

    private async Task DeactivateUser(Guid id, string name)
    {
        var confirmed = await JsRuntime.InvokeAsync<bool>("confirm", $"Deactivate '{name}'? They will no longer be able to log in.");
        if (!confirmed) return;
        await UserManagementApiService.DeactivateUserAsync(id);
        users = await UserManagementApiService.GetUsersAsync();
    }

    private async Task ActivateUser(Guid id, string name)
    {
        var confirmed = await JsRuntime.InvokeAsync<bool>("confirm", $"Activate '{name}'? They will be able to log in again.");
        if (!confirmed) return;
        await UserManagementApiService.ActivateUserAsync(id);
        users = await UserManagementApiService.GetUsersAsync();
    }
}