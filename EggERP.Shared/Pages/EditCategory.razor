@page "/categories/edit/{Id:guid}"
@using EggERP.Shared.Models
@using EggERP.Shared.Services
@inject ICategoryApiService CategoryApiService
@inject NavigationManager Navigation

<h3>Edit Category</h3>

@if (isLoading)
{
    <p>Loading...</p>
}
else if (notFound)
{
    <p>Category not found.</p>
}
else
{
    <EditForm Model="@editModel" OnValidSubmit="HandleSave">
        <div class="mb-3">
            <label>Name</label>
            <InputText class="form-control" @bind-Value="editModel.Name" />
        </div>
        <div class="mb-3">
            <label>Description</label>
            <InputText class="form-control" @bind-Value="editModel.Description" />
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <p style="color:red">@errorMessage</p>
        }

        <button type="submit" class="btn btn-primary">Save</button>
    </EditForm>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private CategoryFormModel editModel = new();
    private bool isLoading = true;
    private bool notFound = false;
    private string? errorMessage;
    private readonly Guid businessId = Guid.Parse("11111111-1111-1111-1111-111111111111");

    protected override async Task OnInitializedAsync()
    {
        var category = await CategoryApiService.GetCategoryByIdAsync(businessId, Id);

        if (category is null)
        {
            notFound = true;
            isLoading = false;
            return;
        }

        editModel = new CategoryFormModel
        {
            Name = category.Name,
            Description = category.Description ?? string.Empty
        };

        isLoading = false;
    }

    private async Task HandleSave()
    {
        errorMessage = null;

        var request = new UpdateCategoryRequest
        {
            Id = Id,
            BusinessId = businessId,
            Name = editModel.Name,
            Description = editModel.Description,
            IsActive = true
        };

        try
        {
            await CategoryApiService.UpdateCategoryAsync(request);
            Navigation.NavigateTo("/categories");
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to save category: {ex.Message}";
        }
    }

    private class CategoryFormModel
    {
        public string Name { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
    }
}