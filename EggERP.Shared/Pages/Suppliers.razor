@page "/suppliers"
@attribute [Authorize(Roles = "Admin,Manager,Staff")]
@using EggERP.Shared.Models
@using EggERP.Shared.Services
@inject ISupplierApiService SupplierApiService
@inject IJSRuntime JsRuntime

<h3>Suppliers</h3>

<a class="btn btn-primary mb-3" href="/suppliers/add">+ Add Supplier</a>

<div class="row mb-3 g-2">
    <div class="col-md-9">
        <input class="form-control"
               placeholder="Search supplier, contact person, email, phone or address..."
               @bind="searchText"
               @bind:event="oninput"
               @bind:after="ResetPage" />
    </div>

    <div class="col-md-3">
        <button class="btn btn-outline-secondary w-100"
                @onclick="ClearFilters">
            Clear
        </button>
    </div>
</div>

@if (suppliers is null)
{
    <p>Loading...</p>
}
else if (!FilteredSuppliers.Any())
{
    <p>No matching suppliers found.</p>
}
else
{
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Contact Person</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Address</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>
                @foreach (var supplier in PagedSuppliers)
                {
                    <tr>
                        <td>@supplier.Name</td>
                        <td>@supplier.ContactPerson</td>
                        <td>@supplier.Email</td>
                        <td>@supplier.Phone</td>
                        <td>@supplier.Address</td>
                        <td>
                            <AuthorizeView Roles="Admin,Manager">
                                <Authorized>
                                    <a class="btn btn-sm btn-secondary"
                                       href="@($"/suppliers/edit/{supplier.Id}")">
                                        Edit
                                    </a>

                                    <button class="btn btn-sm btn-danger"
                                            @onclick="() => DeactivateSupplier(supplier.Id, supplier.Name)">
                                        Deactivate
                                    </button>
                                </Authorized>
                            </AuthorizeView>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <Pager Total="FilteredSuppliers.Count()"
           Page="page"
           PageSize="pageSize"
           PageChanged="OnPageChanged" />
}

@code {
    private List<SupplierDto>? suppliers;
    private string searchText = string.Empty;

    private readonly Guid businessId =
        Guid.Parse("11111111-1111-1111-1111-111111111111");

    private int page = 1;
    private const int pageSize = 7;

    private IEnumerable<SupplierDto> FilteredSuppliers =>
        (suppliers ?? new List<SupplierDto>())
        .Where(s =>
            string.IsNullOrWhiteSpace(searchText) ||
            s.Name.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
            (s.ContactPerson ?? string.Empty).Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
            (s.Email ?? string.Empty).Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
            (s.Phone ?? string.Empty).Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
            (s.Address ?? string.Empty).Contains(searchText, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<SupplierDto> PagedSuppliers =>
        FilteredSuppliers
            .Skip((page - 1) * pageSize)
            .Take(pageSize);

    protected override async Task OnInitializedAsync()
    {
        suppliers = await SupplierApiService.GetSuppliersAsync(businessId);
    }

    private void ResetPage() => page = 1;

    private void OnPageChanged(int newPage) => page = newPage;

    private void ClearFilters()
    {
        searchText = string.Empty;
        page = 1;
    }

    private async Task DeactivateSupplier(Guid id, string name)
    {
        var confirmed = await JsRuntime.InvokeAsync<bool>(
            "confirm",
            $"Deactivate '{name}'? It will be hidden from the active supplier list.");

        if (!confirmed)
        {
            return;
        }

        await SupplierApiService.DeactivateSupplierAsync(businessId, id);
        suppliers = await SupplierApiService.GetSuppliersAsync(businessId);
        page = 1;
    }
}