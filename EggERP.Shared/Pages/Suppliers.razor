@page "/suppliers"
@attribute [Authorize(Roles = "Admin,Manager,Staff")]
@using EggERP.Shared.Models
@using EggERP.Shared.Services
@using EggERP.Shared.Components 
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@inject ISupplierApiService SupplierApiService
@inject CurrentBusinessService CurrentBusiness
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JsRuntime
<h3>Suppliers</h3>
@if (canManage)
{
    <a class="btn btn-primary mb-3" href="/suppliers/add">
        + Add Supplier
    </a>
}

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger" role="alert">
        @errorMessage
    </div>
}

<div class="row mb-3 g-2">
    <div class="col-md-6">
        <input class="form-control"
               placeholder="Search supplier, contact person, email, phone or address..."
               @bind="searchText"
               @bind:event="oninput"
               @bind:after="ResetPage" />
    </div>

    @if (canManage)
    {
        <div class="col-md-3">
            <select class="form-select"
                    @bind="statusFilter"
                    @bind:after="ResetPage">
                <option value="Active">Active</option>
                <option value="Inactive">Inactive</option>
                <option value="All">All</option>
            </select>
        </div>
    }

    <div class="col-md-3">
        <button class="btn btn-outline-secondary w-100"
                disabled="@isBusy"
                @onclick="ClearFilters">
            Clear Filters
        </button>
    </div>
</div>

@if (suppliers is null)
{
    <p>Loading suppliers...</p>
}
else if (!FilteredSuppliers.Any())
{
    <p>No matching suppliers found.</p>
}
else
{
    <div class="erp-table-scroll">
        <table class="table erp-data-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Contact Person</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Address</th>
                    <th>Status</th>
                    @if (canManage)
                    {
                        <th>Actions</th>
                    }
                </tr>
            </thead>

            <tbody>
                @foreach (var supplier in PagedSuppliers)
                {
                    <tr @key="supplier.Id">
                        <td>@supplier.Name</td>
                        <td>@supplier.ContactPerson</td>
                        <td>@supplier.Email</td>
                        <td>@supplier.Phone</td>
                        <td>@supplier.Address</td>
                        <td>
                            <span class="badge @(supplier.IsActive ? "bg-success" : "bg-secondary")">
                                @(supplier.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>

                        @if (canManage)
                        {
                            <td>
                                <div class="erp-table-actions">
                                    <a class="btn btn-sm btn-secondary"
                                       href="@($"/suppliers/edit/{supplier.Id}")">
                                        Edit
                                    </a>

                                    @if (supplier.IsActive)
                                    {
                                        <button class="btn btn-sm btn-danger"
                                                disabled="@isBusy"
                                                @onclick="() => DeactivateSupplier(supplier.Id, supplier.Name)">
                                            Deactivate
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-success"
                                                disabled="@isBusy"
                                                @onclick="() => ReactivateSupplier(supplier.Id, supplier.Name)">
                                            Reactivate
                                        </button>
                                    }
                                </div>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <EzPagination TotalCount="FilteredSuppliers.Count()"
                  Page="page"
                  PageSize="pageSize"
                  Disabled="isBusy"
                  PageChanged="OnPageChanged" />
}

@code {
    private List<SupplierDto>? suppliers;

    private Guid businessId;
    private bool canManage;
    private bool isBusy;

    private string searchText = string.Empty;
    private string statusFilter = "Active";
    private string? errorMessage;

    private int page = 1;
    private const int pageSize = 10;

    private IEnumerable<SupplierDto> FilteredSuppliers =>
        (suppliers ?? new List<SupplierDto>())
        .Where(s =>
            (string.IsNullOrWhiteSpace(searchText) ||
             (s.Name ?? string.Empty).Contains(
                 searchText, StringComparison.OrdinalIgnoreCase) ||
             (s.ContactPerson ?? string.Empty).Contains(
                 searchText, StringComparison.OrdinalIgnoreCase) ||
             (s.Email ?? string.Empty).Contains(
                 searchText, StringComparison.OrdinalIgnoreCase) ||
             (s.Phone ?? string.Empty).Contains(
                 searchText, StringComparison.OrdinalIgnoreCase) ||
             (s.Address ?? string.Empty).Contains(
                 searchText, StringComparison.OrdinalIgnoreCase))
            &&
            (statusFilter == "All" ||
             (statusFilter == "Active" && s.IsActive) ||
             (statusFilter == "Inactive" && !s.IsActive)));

    private IEnumerable<SupplierDto> PagedSuppliers =>
        FilteredSuppliers
            .Skip((page - 1) * pageSize)
            .Take(pageSize);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider
            .GetAuthenticationStateAsync();

        canManage =
            authState.User.IsInRole("Admin") ||
            authState.User.IsInRole("Manager");

        businessId = await CurrentBusiness.GetBusinessIdAsync();

        await RefreshSuppliersAsync();
    }

    private async Task RefreshSuppliersAsync()
    {
        try
        {
            errorMessage = null;

            suppliers = canManage
                ? await SupplierApiService.GetAllSuppliersAsync(businessId)
                : await SupplierApiService.GetSuppliersAsync(businessId);

            var totalPages = Math.Max(
                1,
                (int)Math.Ceiling(FilteredSuppliers.Count() /
                                  (double)pageSize));

            if (page > totalPages)
                page = totalPages;
        }
        catch (Exception ex)
        {
            errorMessage = $"Unable to load suppliers: {ex.Message}";
            suppliers ??= new List<SupplierDto>();
        }
    }

    private void ResetPage()
    {
        page = 1;
    }

    private void OnPageChanged(int newPage)
    {
        page = newPage;
    }

    private void ClearFilters()
    {
        searchText = string.Empty;
        statusFilter = "Active";
        page = 1;
    }

    private async Task DeactivateSupplier(Guid id, string name)
    {
        if (!canManage || isBusy)
            return;

        var confirmed = await JsRuntime.InvokeAsync<bool>(
            "confirm",
            $"Deactivate '{name}'? The supplier will be hidden from active lists.");

        if (!confirmed)
            return;

        await ChangeStatusAsync(id, false);
    }

    private async Task ReactivateSupplier(Guid id, string name)
    {
        if (!canManage || isBusy)
            return;

        var confirmed = await JsRuntime.InvokeAsync<bool>(
            "confirm",
            $"Reactivate '{name}'?");

        if (!confirmed)
            return;

        await ChangeStatusAsync(id, true);
    }

    private async Task ChangeStatusAsync(Guid id, bool activate)
    {
        isBusy = true;
        errorMessage = null;

        try
        {
            if (activate)
            {
                await SupplierApiService
                    .ReactivateSupplierAsync(businessId, id);
            }
            else
            {
                await SupplierApiService
                    .DeactivateSupplierAsync(businessId, id);
            }

            await RefreshSuppliersAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Unable to update supplier: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }
}
