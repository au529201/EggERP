
@using Microsoft.AspNetCore.Components.Authorization

<Router AppAssembly="typeof(Layout.MainLayout).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData"
                            DefaultLayout="typeof(Layout.MainLayout)">

            <NotAuthorized Context="authState">
                <div class="container-fluid py-4">
                    <div class="card shadow-sm border-0 mx-auto"
                         style="max-width: 650px;">

                        <div class="card-body text-center p-4 p-md-5">

                            <div class="mb-3">
                                <i class="bi bi-shield-lock-fill text-warning"
                                   style="font-size: 3rem;"></i>
                            </div>

                            @if (authState.User.Identity?.IsAuthenticated == true)
                            {
                                <h3 class="mb-3">
                                    Access Restricted
                                </h3>

                                <p class="text-muted mb-3">
                                    You do not have permission to access
                                    this page. Your account or business
                                    access may be restricted.
                                </p>
                            }
                            else
                            {
                                <h3 class="mb-3">
                                    Session Expired or Access Restricted
                                </h3>

                                <p class="text-muted mb-3">
                                    Your session is no longer authorized.
                                    If your business has been suspended,
                                    please contact the EzEggERP platform
                                    administrator for assistance.
                                </p>

                                <p class="small text-muted">
                                    Your business records are not deleted
                                    when access is suspended.
                                </p>
                            }

                            <div class="d-flex flex-wrap justify-content-center gap-2 mt-4">
                                <a href="/Account/Login"
                                   class="btn btn-primary">
                                    <i class="bi bi-box-arrow-in-right me-1"></i>
                                    Return to Login
                                </a>
                            </div>

                        </div>
                    </div>
                </div>
            </NotAuthorized>

        </AuthorizeRouteView>

        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>
