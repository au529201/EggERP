﻿<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand d-flex align-items-center" href="">
            <img src="/_content/EggERP.Shared/images/EzEggERP-logo.png" alt="EzEggERP" class="brand-logo" />
            <span>EzEggERP</span>
        </a>
    </div>
</div>
<input type="checkbox" title="Navigation menu" class="navbar-toggler" />
<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <i class="bi bi-house-door-fill me-2" aria-hidden="true"></i> Dashboard
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="products">
                <i class="bi bi-box-seam-fill me-2" aria-hidden="true"></i> Products
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="inventory">
                <i class="bi bi-boxes me-2" aria-hidden="true"></i> Inventory
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="customers">
                <i class="bi bi-people-fill me-2" aria-hidden="true"></i> Customers
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="suppliers">
                <i class="bi bi-truck me-2" aria-hidden="true"></i> Suppliers
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="sales">
                <i class="bi bi-cart-check-fill me-2" aria-hidden="true"></i> Sales
            </NavLink>
        </div>
        <AuthorizeView Roles="Admin,Manager">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="purchases">
                        <i class="bi bi-bag-plus-fill me-2" aria-hidden="true"></i> Purchases
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="expenses">
                        <i class="bi bi-cash-stack me-2" aria-hidden="true"></i> Expenses
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>
        <AuthorizeView Roles="Admin">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="settings/business">
                        <i class="bi bi-gear-fill me-2" aria-hidden="true"></i> Settings
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="settings/users">
                        <i class="bi bi-person-badge-fill me-2" aria-hidden="true"></i> Users
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>
        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <form method="post" action="/Account/Logout" onsubmit="return confirm('Are you sure you want to log out?');">
                        <button type="submit" class="nav-link btn btn-link text-start w-100 border-0">
                            <i class="bi bi-box-arrow-right me-2" aria-hidden="true"></i> Logout (@context.User.Identity?.Name)
                        </button>
                    </form>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <a class="nav-link" href="/Account/Login">
                        <i class="bi bi-box-arrow-in-right me-2" aria-hidden="true"></i> Login
                    </a>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>