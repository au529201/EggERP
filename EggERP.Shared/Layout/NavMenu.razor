<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid d-flex align-items-center justify-content-between">
        <a class="navbar-brand d-flex align-items-center" href="">
            <img src="/_content/EggERP.Shared/images/logoEz.png" alt="EzEggERP" class="brand-logo" />
            <span class="brand-text">EzEggERP</span>
        </a>
        <button type="button" class="collapse-toggle d-none d-md-inline-flex"
                title="Collapse menu"
                onclick="this.closest('.sidebar').classList.toggle('sidebar-collapsed')">
            <i class="bi bi-chevron-left"></i>
        </button>
    </div>
</div>
<input type="checkbox" title="Navigation menu" class="navbar-toggler" />
<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <i class="bi bi-house-door-fill me-2" aria-hidden="true"></i> <span class="nav-text">Dashboard</span>
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="products">
                <i class="bi bi-box-seam-fill me-2" aria-hidden="true"></i> <span class="nav-text">Products</span>
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="inventory">
                <i class="bi bi-boxes me-2" aria-hidden="true"></i> <span class="nav-text">Inventory</span>
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="flocks">
                <i class="bi bi-feather2 me-2" aria-hidden="true"></i> <span class="nav-text">Flocks</span>
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="eggs">
                <i class="bi bi-egg-fill me-2" aria-hidden="true"></i> <span class="nav-text">Eggs</span>
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="customers">
                <i class="bi bi-people-fill me-2" aria-hidden="true"></i> <span class="nav-text">Customers</span>
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="suppliers">
                <i class="bi bi-truck me-2" aria-hidden="true"></i> <span class="nav-text">Suppliers</span>
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="sales">
                <i class="bi bi-cart-check-fill me-2" aria-hidden="true"></i> <span class="nav-text">Sales</span>
            </NavLink>
        </div>
        <AuthorizeView Roles="Admin,Manager">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="purchases">
                        <i class="bi bi-bag-plus-fill me-2" aria-hidden="true"></i> <span class="nav-text">Purchases</span>
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="expenses">
                        <i class="bi bi-cash-stack me-2" aria-hidden="true"></i> <span class="nav-text">Expenses</span>
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="history">
                        <i class="bi bi-clock-history me-2" aria-hidden="true"></i> <span class="nav-text">History</span>
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <button type="button" class="nav-link settings-toggle" @onclick="() => settingsOpen = !settingsOpen">
                        <i class="bi bi-gear-fill me-2" aria-hidden="true"></i>
                        <span class="nav-text">Settings</span>
                        <i class="bi @(settingsOpen ? "bi-chevron-up" : "bi-chevron-down") settings-caret"></i>
                    </button>
                    @if (settingsOpen)
                    {
                        <div class="nav-submenu">
                            <AuthorizeView Roles="Admin" Context="adminSettingsAuth">
                                <Authorized>
                                    <div class="nav-item px-3 nav-item-sub">
                                        <NavLink class="nav-link" href="settings/business">
                                            <span class="nav-text">Business Settings</span>
                                        </NavLink>
                                    </div>
                                    <div class="nav-item px-3 nav-item-sub">
                                        <NavLink class="nav-link" href="settings/users">
                                            <span class="nav-text">Users</span>
                                        </NavLink>
                                    </div>
                                </Authorized>
                            </AuthorizeView>
                            <div class="nav-item px-3 nav-item-sub">
                                <NavLink class="nav-link" href="about">
                                    <span class="nav-text">About EzEggERP</span>
                                </NavLink>
                            </div>
                        </div>
                    }
                </div>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <form method="post" action="/Account/Logout" onsubmit="return confirm('Are you sure you want to log out?');">
                        <button type="submit" class="nav-link btn btn-link text-start w-100 border-0">
                            <i class="bi bi-box-arrow-right me-2" aria-hidden="true"></i> <span class="nav-text">Logout</span>
                        </button>
                    </form>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <a class="nav-link" href="/Account/Login">
                        <i class="bi bi-box-arrow-in-right me-2" aria-hidden="true"></i> <span class="nav-text">Login</span>
                    </a>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

<nav class="bottom-nav d-md-none">
    <NavLink class="bottom-nav-link" href="" Match="NavLinkMatch.All">
        <i class="bi bi-house-door-fill"></i>
        <span>Home</span>
    </NavLink>
    <NavLink class="bottom-nav-link" href="inventory">
        <i class="bi bi-boxes"></i>
        <span>Inventory</span>
    </NavLink>
    <NavLink class="bottom-nav-link" href="sales">
        <i class="bi bi-cart-check-fill"></i>
        <span>Sales</span>
    </NavLink>
    <a class="bottom-nav-link" href="javascript:void(0)" onclick="document.querySelector('.navbar-toggler').click()">
        <i class="bi bi-list"></i>
        <span>More</span>
    </a>
</nav>

@code {
    private bool settingsOpen = false;
}