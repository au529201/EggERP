@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing

<div class="nav-shell @(IsCollapsed ? "is-collapsed" : "") @(menuOpen ? "is-menu-open" : "")">

    <div class="nav-header">
        <a class="brand-link"
           href="/"
           @onclick="CloseMobileMenu">

            <img class="brand-logo"
                 src="/_content/EggERP.Shared/images/logo.png"
                 alt="EzEggERP" />

            <span class="brand-text">EzEggERP</span>
        </a>

        <!-- Desktop collapse button -->
        <button type="button"
                class="collapse-toggle"
                title="@(IsCollapsed ? "Expand sidebar" : "Collapse sidebar")"
                aria-label="@(IsCollapsed ? "Expand sidebar" : "Collapse sidebar")"
                @onclick="ToggleCollapse">

            <i class="bi @(IsCollapsed
                ? "bi-chevron-right"
                : "bi-chevron-left")"
               aria-hidden="true"></i>
        </button>

        <!-- Mobile menu button -->
        <button type="button"
                class="mobile-menu-toggle"
                title="Menu"
                aria-label="@(menuOpen ? "Close menu" : "Open menu")"
                aria-expanded="@menuOpen"
                @onclick="ToggleMobileMenu">

            <i class="bi @(menuOpen
                ? "bi-x-lg"
                : "bi-list")"
               aria-hidden="true"></i>
        </button>
    </div>

    <div class="nav-scrollable">

        <div class="nav-item">
            <NavLink class="nav-link"
                     href="/"
                     Match="NavLinkMatch.All"
                     @onclick="CloseMobileMenu">

                <i class="bi bi-house-door-fill"
                   aria-hidden="true"></i>

                <span class="nav-text">Dashboard</span>
            </NavLink>
        </div>

        <div class="nav-item">
            <NavLink class="nav-link"
                     href="/products"
                     @onclick="CloseMobileMenu">

                <i class="bi bi-box-fill"
                   aria-hidden="true"></i>

                <span class="nav-text">Products</span>
            </NavLink>
        </div>

        <div class="nav-item">
            <NavLink class="nav-link"
                     href="/inventory"
                     @onclick="CloseMobileMenu">

                <i class="bi bi-boxes"
                   aria-hidden="true"></i>

                <span class="nav-text">Inventory</span>
            </NavLink>
        </div>

        <div class="nav-item">
            <NavLink class="nav-link"
                     href="/flocks"
                     @onclick="CloseMobileMenu">

                <i class="bi bi-signpost-split"
                   aria-hidden="true"></i>

                <span class="nav-text">Flocks</span>
            </NavLink>
        </div>

        <div class="nav-item">
            <NavLink class="nav-link"
                     href="/eggs"
                     @onclick="CloseMobileMenu">

                <i class="bi bi-egg-fill"
                   aria-hidden="true"></i>

                <span class="nav-text">Eggs</span>
            </NavLink>
        </div>

        <div class="nav-item">
            <NavLink class="nav-link"
                     href="/customers"
                     @onclick="CloseMobileMenu">

                <i class="bi bi-people-fill"
                   aria-hidden="true"></i>

                <span class="nav-text">Customers</span>
            </NavLink>
        </div>

        <div class="nav-item">
            <NavLink class="nav-link"
                     href="/suppliers"
                     @onclick="CloseMobileMenu">

                <i class="bi bi-truck"
                   aria-hidden="true"></i>

                <span class="nav-text">Suppliers</span>
            </NavLink>
        </div>

        <div class="nav-item">
            <NavLink class="nav-link"
                     href="/sales"
                     @onclick="CloseMobileMenu">

                <i class="bi bi-cart-check-fill"
                   aria-hidden="true"></i>

                <span class="nav-text">Sales</span>
            </NavLink>
        </div>

        <div class="nav-item">
            <NavLink class="nav-link"
                     href="/purchases"
                     @onclick="CloseMobileMenu">

                <i class="bi bi-bag-plus-fill"
                   aria-hidden="true"></i>

                <span class="nav-text">Purchases</span>
            </NavLink>
        </div>

        <div class="nav-item">
            <NavLink class="nav-link"
                     href="/expenses"
                     @onclick="CloseMobileMenu">

                <i class="bi bi-cash-stack"
                   aria-hidden="true"></i>

                <span class="nav-text">Expenses</span>
            </NavLink>
        </div>

        <div class="nav-item">
            <NavLink class="nav-link"
                     href="/history"
                     @onclick="CloseMobileMenu">

                <i class="bi bi-clock-history"
                   aria-hidden="true"></i>

                <span class="nav-text">History</span>
            </NavLink>
        </div>

        <AuthorizeView Roles="Admin">
            <Authorized Context="adminContext">

                <div class="nav-item">

                    <button type="button"
                            class="nav-link settings-toggle"
                            aria-expanded="@settingsOpen"
                            @onclick="ToggleSettings">

                        <i class="bi bi-gear-fill"
                           aria-hidden="true"></i>

                        <span class="nav-text">Settings</span>

                        <i class="bi @(settingsOpen
                            ? "bi-chevron-up"
                            : "bi-chevron-down") settings-caret"
                           aria-hidden="true"></i>
                    </button>

                    @if (settingsOpen && !IsCollapsed)
                    {
                        <div class="nav-submenu">

                            <div class="nav-item nav-item-sub">
                                <NavLink class="nav-link"
                                         href="/settings/users"
                                         @onclick="CloseMobileMenu">

                                    <i class="bi bi-person-gear"
                                       aria-hidden="true"></i>

                                    <span class="nav-text">
                                        User Management
                                    </span>
                                </NavLink>
                            </div>

                            <div class="nav-item nav-item-sub">
                                <NavLink class="nav-link"
                                         href="/profile"
                                         @onclick="CloseMobileMenu">

                                    <i class="bi bi-person-circle"
                                       aria-hidden="true"></i>

                                    <span class="nav-text">
                                        My Profile
                                    </span>
                                </NavLink>
                            </div>

                        </div>
                    }

                </div>

            </Authorized>
        </AuthorizeView>

    </div>

    @if (menuOpen)
    {
        <button type="button"
                class="menu-backdrop"
                aria-label="Close menu"
                @onclick="CloseMobileMenu">
        </button>
    }

    <!-- Phone bottom navigation -->
    <nav class="bottom-nav"
         aria-label="Mobile navigation">

        <NavLink class="bottom-nav-link"
                 href="/"
                 Match="NavLinkMatch.All"
                 @onclick="CloseMobileMenu">

            <i class="bi bi-house-door-fill"
               aria-hidden="true"></i>

            <span>Home</span>
        </NavLink>

        <NavLink class="bottom-nav-link"
                 href="/inventory"
                 @onclick="CloseMobileMenu">

            <i class="bi bi-boxes"
               aria-hidden="true"></i>

            <span>Inventory</span>
        </NavLink>

        <NavLink class="bottom-nav-link"
                 href="/sales"
                 @onclick="CloseMobileMenu">

            <i class="bi bi-cart-check-fill"
               aria-hidden="true"></i>

            <span>Sales</span>
        </NavLink>

        <button type="button"
                class="bottom-nav-link"
                @onclick="ToggleMobileMenu">

            <i class="bi bi-list"
               aria-hidden="true"></i>

            <span>More</span>
        </button>

    </nav>

</div>

@code {
    /*
     * These two parameters are REQUIRED because MainLayout uses:
     *
     * <NavMenu @bind-IsCollapsed="sidebarCollapsed" />
     *
     * @bind-IsCollapsed requires:
     * 1. IsCollapsed
     * 2. IsCollapsedChanged
     */

    [Parameter]
    public bool IsCollapsed { get; set; }

    [Parameter]
    public EventCallback<bool> IsCollapsedChanged { get; set; }


    private bool menuOpen;
    private bool settingsOpen;


    private async Task ToggleCollapse()
    {
        IsCollapsed = !IsCollapsed;

        if (IsCollapsed)
        {
            settingsOpen = false;
        }

        await IsCollapsedChanged.InvokeAsync(IsCollapsed);
    }


    private void ToggleMobileMenu()
    {
        menuOpen = !menuOpen;
    }


    private void CloseMobileMenu()
    {
        menuOpen = false;
    }


    private void ToggleSettings()
    {
        settingsOpen = !settingsOpen;
    }
}